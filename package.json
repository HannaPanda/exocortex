{
  "name": "exocortex",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "eXocortex - self-hostable collaborative workspace and external brain",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "node scripts/check-dependency-boundaries.mjs && oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "bash scripts/test-integration.sh",
    "test:gates": "vitest run",
    "test:e2e": "pnpm --filter @exocortex/e2e test:e2e",
    "test:styleguide": "bash scripts/test-styleguide.sh",
    "test:styleguide:update": "bash scripts/test-styleguide.sh --update-snapshots",
    "test:visual": "bash scripts/test-styleguide.sh visual.spec.ts",
    "test:a11y": "bash scripts/test-styleguide.sh a11y.spec.ts",
    "db:generate": "pnpm --filter @exocortex/database db:generate",
    "db:migrate": "pnpm --filter @exocortex/database db:migrate",
    "db:seed": "pnpm --filter @exocortex/database db:seed",
    "db:provision-user": "pnpm --filter @exocortex/database db:provision-user --",
    "db:reset": "pnpm --filter @exocortex/database db:reset",
    "data:generate": "node scripts/generate-icon-data.mjs && node scripts/generate-emoji-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node scripts/generate-app-icons.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-syntax-decorators": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@next/eslint-plugin-next": "16.3.5",
    "@types/node": "24.10.4",
    "@vitest/coverage-v8": "5.0.0",
    "emojibase-data": "17.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-oxlint": "1.83.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "oxlint": "1.83.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
