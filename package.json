{
  "name": "exocortex",
  "version": "0.1.0",
  "private": true,
  "description": "eXocortex - self-hostable collaborative workspace and external brain",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "node scripts/check-dependency-boundaries.mjs && turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @exocortex/api test-data:prune && turbo run test",
    "test:gates": "vitest run",
    "test:e2e": "pnpm --filter @exocortex/e2e test:e2e",
    "db:generate": "pnpm --filter @exocortex/database db:generate",
    "db:migrate": "pnpm --filter @exocortex/database db:migrate",
    "db:seed": "pnpm --filter @exocortex/database db:seed",
    "db:provision-user": "pnpm --filter @exocortex/database db:provision-user --",
    "db:reset": "pnpm --filter @exocortex/database db:reset",
    "data:generate": "node scripts/generate-icon-data.mjs && node scripts/generate-emoji-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node scripts/generate-app-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@types/node": "24.10.4",
    "@vitest/coverage-v8": "5.0.0",
    "emojibase-data": "17.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
