{
  "name": "@exocortex/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS REST API, application WebSocket gateway and domain services",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests integration.test",
    "token:create": "tsx scripts/create-api-token.ts",
    "import:obsidian": "tsx scripts/import-obsidian.ts",
    "workspaces:delete": "tsx scripts/delete-workspaces.ts",
    "documents:delete": "tsx scripts/delete-documents.ts",
    "documents:trim-paragraphs": "tsx scripts/trim-stray-paragraphs.ts",
    "test-data:prune": "tsx scripts/delete-test-data.ts"
  },
  "dependencies": {
    "@exocortex/ai": "workspace:*",
    "@exocortex/auth": "workspace:*",
    "@exocortex/config": "workspace:*",
    "@exocortex/contracts": "workspace:*",
    "@exocortex/database": "workspace:*",
    "@exocortex/editor": "workspace:*",
    "@exocortex/features": "workspace:*",
    "@exocortex/logger": "workspace:*",
    "@exocortex/mcp-tools": "workspace:*",
    "@exocortex/queue": "workspace:*",
    "@exocortex/storage": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/platform-socket.io": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/websockets": "12.0.3",
    "fastify": "5.12.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@types/node": "24.10.4",
    "jose": "6.2.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
