    "better-auth": "1.6.33",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/nodemailer": "8.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
