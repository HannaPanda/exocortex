{
  "name": "@exocortex/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Better Auth configuration, session verification and centralized authorization policies",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests integration.test"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.5",
    "@exocortex/config": "workspace:*",
    "@exocortex/contracts": "workspace:*",
    "@exocortex/database": "workspace:*",
    "@exocortex/logger": "workspace:*",
    "better-auth": "1.7.5",
    "jose": "6.2.7",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/nodemailer": "8.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
