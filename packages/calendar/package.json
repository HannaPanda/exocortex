{
  "name": "@exocortex/calendar",
  "version": "0.1.0",
  "private": true,
  "description": "CalDAV client and iCalendar parsing: discovery, incremental sync, typed events and todos",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests integration.test"
  },
  "dependencies": {
    "@exocortex/logger": "workspace:*",
    "fast-xml-parser": "5.11.1",
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
