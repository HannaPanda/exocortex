{
  "name": "@exocortex/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral AI abstraction, mock streaming provider and CLI agent runner contracts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests integration.test"
  },
  "dependencies": {
    "@exocortex/config": "workspace:*",
    "@exocortex/contracts": "workspace:*",
    "@exocortex/logger": "workspace:*",
    "pdf-lib": "1.17.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
