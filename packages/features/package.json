{
  "name": "@exocortex/features",
  "version": "0.1.0",
  "private": true,
  "description": "The feature registry: what a person can do with this deployment, in a person's words",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests integration.test"
  },
  "dependencies": {
    "@exocortex/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
