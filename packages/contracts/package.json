{
  "name": "@exocortex/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime-validated shared contracts: REST DTOs, WebSocket events and job payloads",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
