{
  "name": "@exocortex/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Exocortex design system: theme tokens, shadcn/ui components on Base UI primitives, layout primitives and reusable states",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
