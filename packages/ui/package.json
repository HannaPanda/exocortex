    "lint": "eslint src",
    "test": "echo \"no unit tests: UI is covered by Playwright\""
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
