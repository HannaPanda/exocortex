{
  "name": "@exocortex/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, generated client and ordering primitives",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma",
    "generated"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:ai-models": "tsx prisma/seed-ai-models.ts",
    "db:provision-user": "tsx scripts/provision-user.ts",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma",
    "test": "vitest run"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@exocortex/config": "workspace:*",
    "@exocortex/logger": "workspace:*",
    "@prisma/client": "6.19.3",
    "@exocortex/contracts": "workspace:*",
    "@exocortex/editor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
