// Exocortex database schema.
//
// Conventions:
//  * `cuid(2)` identifiers, generated by the database layer, never by clients.
//  * `yjsState` columns hold the canonical binary Yjs document state (ADR-005).
//  * Derived representations (ProseMirror JSON, plain text, Markdown) live next
//    to the canonical state and are always rebuilt by the materialization job.
//  * Anything requiring raw SQL (tsvector, pgvector) is modelled with
//    `Unsupported(...)` and maintained by explicit SQL in migrations/jobs.

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth models (email + password, sessions, verification tokens)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid(2))
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  memberships        WorkspaceMember[]
  createdDocuments   Document[]          @relation("DocumentCreatedBy")
  updatedDocuments   Document[]          @relation("DocumentUpdatedBy")
  createdSnapshots   DocumentSnapshot[]
  createdAttachments Attachment[]
  auditEntries       AuditLog[]
  aiRuns             AiRun[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Argon2/scrypt hash managed by Better Auth. Never logged, never returned.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Workspaces
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model Workspace {
  id        String    @id @default(cuid(2))
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archivedAt DateTime?

  members     WorkspaceMember[]
  documents   Document[]
  attachments Attachment[]
  outbox      OutboxEvent[]
  auditLog    AuditLog[]
  aiRuns      AiRun[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id @default(cuid(2))
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentType {
  PAGE
  COLLECTION
}

model Document {
  id          String       @id @default(cuid(2))
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Document?    @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Document[]   @relation("DocumentHierarchy")
  type        DocumentType @default(PAGE)
  title       String
  icon        String?
  /// Fractional index (base62). Lets a document be inserted between two
  /// siblings without renumbering the rest of the tree.
  ///
  /// The column uses the `C` collation (see migration
  /// 20260804101500_order_key_c_collation) so comparisons use byte order, which
  /// is what the fractional index algorithm assumes.
  orderKey    String
  createdById String
  createdBy   User         @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User         @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  content     DocumentContent?
  snapshots   DocumentSnapshot[]
  searchIndex DocumentSearchIndex?
  embeddings  DocumentEmbedding[]
  attachments Attachment[]
  aiRuns      AiRun[]

  @@index([workspaceId, parentId, orderKey])
  @@index([workspaceId, archivedAt])
  @@map("document")
}

model DocumentContent {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Canonical collaborative state. Never rebuilt from derived data.
  yjsState        Bytes
  schemaVersion   Int      @default(1)
  /// Timestamp of the last binary Yjs write. Used for job idempotency.
  yjsUpdatedAt    DateTime @default(now())
  /// Derived representations. All of them are rebuilt by materialization.
  proseMirrorJson Json?
  plainText       String?
  markdown        String?
  materializedAt  DateTime?
  updatedAt       DateTime @updatedAt

  @@map("document_content")
}

enum SnapshotReason {
  MANUAL
  SCHEDULED
  PRE_RESTORE
  IMPORT
  RESTORE
}

model DocumentSnapshot {
  id            String         @id @default(cuid(2))
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  yjsState      Bytes
  schemaVersion Int            @default(1)
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reason        SnapshotReason
  createdAt     DateTime       @default(now())

  @@index([documentId, createdAt])
  @@map("document_snapshot")
}

/// Search projection maintained by the `search-indexing` queue.
/// `searchVector` is a generated tsvector maintained through raw SQL because
/// Prisma has no native tsvector type.
model DocumentSearchIndex {
  documentId   String                   @id
  document     Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspaceId  String
  title        String
  plainText    String
  archivedAt   DateTime?
  updatedAt    DateTime                 @updatedAt
  searchVector Unsupported("tsvector")?

  @@index([workspaceId])
  @@map("document_search_index")
}

/// Prepared for future semantic search. No embeddings are generated yet
/// (see docs/architecture.md, "Deferred work").
model DocumentEmbedding {
  id         String                     @id @default(cuid(2))
  documentId String
  document   Document                   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  blockId    String?
  model      String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                   @default(now())

  @@index([documentId])
  @@map("document_embedding")
}

// ---------------------------------------------------------------------------
// Attachments
// ---------------------------------------------------------------------------

model Attachment {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  filename    String
  /// MIME type detected from the file magic bytes, not from the browser.
  mimeType    String
  byteSize    Int
  /// Server-generated object key. Clients never choose storage keys.
  storageKey  String    @unique
  checksum    String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([workspaceId, createdAt])
  @@index([documentId])
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Transactional infrastructure
// ---------------------------------------------------------------------------

/// Transactional outbox: domain events written in the same transaction as the
/// state change they describe, then dispatched by the maintenance queue.
model OutboxEvent {
  id            String    @id @default(cuid(2))
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type          String
  payload       Json
  correlationId String
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([processedAt, createdAt])
  @@map("outbox_event")
}

/// Audit trail for destructive and permission-relevant operations.
/// Must never contain document contents or secrets.
model AuditLog {
  id            String    @id @default(cuid(2))
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  targetType    String
  targetId      String
  metadata      Json?
  correlationId String
  createdAt     DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// AI runs
// ---------------------------------------------------------------------------

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

model AiRun {
  id          String      @id @default(cuid(2))
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  status      AiRunStatus @default(PENDING)
  provider    String
  model       String
  /// Prompt messages as submitted by the user. Document contents are not
  /// injected in this version.
  messages    Json
  resultText  String?
  usage       Json?
  errorCode   String?
  createdAt   DateTime    @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  cancelledAt DateTime?

  @@index([workspaceId, createdAt])
  @@map("ai_run")
}
