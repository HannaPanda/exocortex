// Exocortex database schema.
//
// Conventions:
//  * `cuid(2)` identifiers, generated by the database layer, never by clients.
//  * `yjsState` columns hold the canonical binary Yjs document state (ADR-005).
//  * Derived representations (ProseMirror JSON, plain text, Markdown) live next
//    to the canonical state and are always rebuilt by the materialization job.
//  * Anything requiring raw SQL (tsvector, pgvector) is modelled with
//    `Unsupported(...)` and maintained by explicit SQL in migrations/jobs.

// `engineType = "library"` used to sit here and no longer says anything. Prisma
// 7 connects through a driver adapter and compiles queries with the WebAssembly
// query compiler that ships inside the generated client; generating with the
// line and without it produces the same files, and neither produces a Rust
// engine binary. A setting that names a binary this client never loads is worse
// than no setting.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// The connection URL is not here. Prisma 7 rejects `url = env(...)` in the
// schema (P1012); it lives in `prisma.config.ts` next to this file.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth models (email + password, sessions, verification tokens)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid(2))
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Global (cross-workspace) role. Distinct from WorkspaceRole: a global admin
  /// administers the deployment, a workspace ADMIN administers one workspace.
  role          UserRole  @default(USER)
  /// When set, the account exists but may not act: sign-in is refused and every
  /// credential is rejected. Deliberately not a deletion -- documents point at
  /// their author through `createdById`/`updatedById`, so removing the row would
  /// take the history with it. Reversible by clearing the field.
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions                    Session[]
  accounts                    Account[]
  memberships                 WorkspaceMember[]
  createdDocuments            Document[]            @relation("DocumentCreatedBy")
  updatedDocuments            Document[]            @relation("DocumentUpdatedBy")
  createdSnapshots            DocumentSnapshot[]
  createdAttachments          Attachment[]
  correctedAttachmentTexts    Attachment[]          @relation("AttachmentTextCorrectedBy")
  auditEntries                AuditLog[]
  aiRuns                      AiRun[]
  apiTokens                   ApiToken[]
  updatedSettings             Setting[]             @relation("SettingUpdatedBy")
  updatedWorkspaceSettings    WorkspaceSetting[]    @relation("WorkspaceSettingUpdatedBy")
  createdWorkspaceCredentials WorkspaceCredential[] @relation("WorkspaceCredentialCreatedBy")
  aiConversations             AiConversation[]      @relation("AiConversationCreatedBy")
  projectBuilds               ProjectBuild[]        @relation("ProjectBuildCreatedBy")
  calendarAccounts            CalendarAccount[]     @relation("CalendarAccountOwner")
  comments                    Comment[]             @relation("CommentCreatedBy")
  resolvedComments            Comment[]             @relation("CommentResolvedBy")
  oauthClients                OauthClient[]
  oauthAccessTokens           OauthAccessToken[]
  oauthRefreshTokens          OauthRefreshToken[]
  oauthConsents               OauthConsent[]
  sentInvitations             Invitation[]          @relation("InvitationInvitedBy")
  acceptedInvitation          Invitation?           @relation("InvitationAcceptedBy")
  agentSessions               AgentSession[]
  agentWrites                 AgentWriteJournal[]
  automationRules             AutomationRule[]      @relation("AutomationRuleCreatedBy")
  renderTemplates             RenderTemplate[]      @relation("RenderTemplateCreatedBy")
  renderJobs                  RenderJob[]           @relation("RenderJobCreatedBy")

  @@map("user")
}

/// Global (cross-workspace) role. Distinct from WorkspaceRole: a global admin
/// administers the deployment, a workspace ADMIN administers one workspace.
enum UserRole {
  USER
  ADMIN
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Argon2/scrypt hash managed by Better Auth. Never logged, never returned.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// OAuth 2.1 authorization server (`@better-auth/mcp` + the `jwt` plugin)
// ---------------------------------------------------------------------------
//
// These tables exist for one reason: ChatGPT cannot start a subprocess, so it
// cannot speak the stdio MCP transport, and it does not let a person paste an
// API token either. A remote MCP connector authenticates with OAuth and
// registers itself dynamically (RFC 7591), which needs an authorization
// server -- this one. Field names and shapes are dictated by the plugin's
// adapter mapping; see docs/mcp.md.
//
// Nothing in the application writes to any of them. The plugin owns every row,
// which is why the columns are named the way better-auth names them rather
// than the way the rest of this schema reads.

/// The signing keys of the authorization server. The public half is published
/// at `/api/auth/jwks`; the private half is encrypted with the deployment
/// secret. Access tokens are signed with these, which is what lets
/// `verifyMcpAccessToken` check one without a round trip.
model Jwks {
  id         String    @id @default(cuid(2))
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

/// An OAuth client. Almost every row here is written by dynamic client
/// registration rather than by a human, so `name` and `redirectUris` are
/// whatever the registering client claimed. Nothing downstream may treat them
/// as trustworthy: they are shown on the consent page precisely so a person
/// decides, and `disabled` is how that decision is revoked later.
model OauthClient {
  id                               String    @id @default(cuid(2))
  clientId                         String    @unique
  /// Null for public clients, which prove themselves with PKCE instead.
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  /// Set on a client that may skip the consent screen. Never set here: the
  /// screen is the gate in front of open registration.
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]  @default([])
  clientCredentialsScopes          String[]  @default([])
  /// Who registered it, when registration happened in a session. Null for
  /// anonymous dynamic registration, which is the normal case for ChatGPT.
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime? @default(now())
  updatedAt                        DateTime? @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]  @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]  @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]  @default([])
  responseTypes                    String[]  @default([])
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  accessTokens  OauthAccessToken[]
  refreshTokens OauthRefreshToken[]
  consents      OauthConsent[]
  resources     OauthClientResource[]

  @@index([userId])
  @@map("oauth_client")
}

/// A protected resource tokens can be issued for (RFC 8707). This deployment
/// has exactly one, `<APP_URL>/api/mcp`, seeded by the plugin from its
/// `resource` option; the row exists so per-resource policy has somewhere to
/// live, not because there is a second one to tell apart.
model OauthResource {
  id                            String    @id @default(cuid(2))
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]  @default([])
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @default(now())
  updatedAt                     DateTime? @updatedAt
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clients OauthClientResource[]

  @@map("oauth_resource")
}

/// Which client may ask for which resource. Only authoritative when the plugin
/// runs with `enforcePerClientResources`, which it does not here; the rows are
/// still written, because registration links every new client to the one
/// resource this server has.
model OauthClientResource {
  id         String        @id @default(cuid(2))
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @default(now())

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

/// An issued refresh token. Stored hashed, unlike the pair better-auth 1.6
/// kept in the clear: the plugin looks one up by its own digest now, so the
/// column is useless to anyone who reads the table.
model OauthRefreshToken {
  id                      String      @id @default(cuid(2))
  token                   String      @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  expiresAt               DateTime
  createdAt               DateTime    @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

/// An opaque access token. Empty in this deployment, and that is the point:
/// every token `@better-auth/mcp` issues is bound to a resource audience and
/// is therefore a signed JWT that is never written down. The table is part of
/// the plugin's schema and the plugin writes to it for grants that have no
/// audience, so it exists rather than being left out.
model OauthAccessToken {
  id                      String             @id @default(cuid(2))
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

/// A person's recorded "yes" to one client. Its absence is what makes the
/// consent page appear -- though here it appears anyway, because the API adds
/// `prompt=consent` to every authorization request.
model OauthConsent {
  id                      String      @id @default(cuid(2))
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  scopes                  String[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

/// One row per `private_key_jwt` client assertion, so a replay collides on the
/// primary key. No client here authenticates that way; the table belongs to
/// the plugin's schema all the same.
model OauthClientAssertion {
  id        String   @id @default(cuid(2))
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

// ---------------------------------------------------------------------------
// Global roles and runtime settings
// ---------------------------------------------------------------------------

/// DB-backed runtime settings. The environment stays the bootstrap fallback:
/// a key absent here resolves to its env value, then to its zod default, so
/// every process still boots with an empty table (see resolveSettings()).
model Setting {
  key         String   @id
  /// Raw JSON value. Validated against settingsSchema in @exocortex/contracts
  /// on read and on write, so a hand-edited row can never crash a process.
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("setting")
}

/// Long-lived bearer credential for external clients (MCP servers, scripts).
/// Carries the full permissions of its user; scoping beyond that is reserved.
model ApiToken {
  id         String    @id @default(cuid(2))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// SHA-256 of the raw token. The raw value is returned exactly once, at
  /// creation, and is never stored or logged.
  tokenHash  String    @unique
  /// First 12 characters of the raw token, so a token is recognisable in a list.
  prefix     String
  /// What this token may do: 'read', 'write', 'admin'. Cumulative, so 'write'
  /// implies 'read'. Enforced by TokenScopeGuard in the API. An empty array
  /// grants nothing -- it fails closed, so a row that predates scoping cannot
  /// quietly keep full authority.
  scopes     String[]  @default(["read"])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_token")
}

/// The only way an account comes into being besides the seed script (issue #3).
///
/// Self-registration is off, so an invitation is what turns "somebody has an
/// email address" into "somebody has an account here". It carries the workspace
/// the person is expected to land in, because memberships are explicit: without
/// one, an invited friend signs up and stares at an empty application.
model Invitation {
  id        String @id @default(cuid(2))
  /// Lowercased at write time. The address the token was sent to, and the only
  /// address the invitation can create an account for -- the person redeeming it
  /// cannot substitute another one.
  email     String
  /// SHA-256 of the raw token, exactly like `ApiToken.tokenHash`. The raw value
  /// travels in the invitation link and is never stored, so a database dump
  /// cannot be replayed into accounts.
  tokenHash String @unique

  invitedById String
  invitedBy   User   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  /// Where the invited person becomes a member on acceptance. Null means the
  /// invitation only creates the account; the person then has no workspace until
  /// somebody adds them or they create their own.
  workspaceId   String?
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Role granted in `workspaceId`. Meaningless without one, and never OWNER:
  /// ownership is transferred deliberately, not handed out in a mail.
  workspaceRole WorkspaceRole?

  /// Optional global role for the new account. Only a global admin may set this
  /// to ADMIN; a workspace admin inviting into their own workspace cannot.
  role UserRole @default(USER)

  expiresAt    DateTime
  /// Set once, when the invitation was redeemed. A second redemption is refused.
  acceptedAt   DateTime?
  /// The account that came out of this invitation, so an admin can see what an
  /// invitation turned into. Unique: one invitation, one account.
  acceptedById String?   @unique
  acceptedBy   User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  /// How often the invitation mail was sent, including the first time. Visible
  /// in the admin list so "did it arrive?" has an answer.
  sentCount    Int       @default(1)
  /// When the mail last went out, or null when sending failed every time. That
  /// case is the reason "Link kopieren" exists in the UI.
  lastSentAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([workspaceId])
  @@index([invitedById])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Workspaces
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model Workspace {
  id         String    @id @default(cuid(2))
  name       String
  slug       String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  /// Whether this workspace is an agent memory area (issue #52, ADR-019,
  /// ADR-023). A property of the row rather than a deployment setting,
  /// because `recall` and `remember` are handed a user and a project and
  /// never a workspace: there is no context a per-workspace override could
  /// have been resolved against, and one pointer for the whole installation
  /// meant every account shared one memory. Resolution for a user is "the
  /// memory workspace among their memberships"; several is legal and the
  /// oldest membership wins, deterministically.
  isMemory Boolean @default(false)

  members          WorkspaceMember[]
  documents        Document[]
  attachments      Attachment[]
  outbox           OutboxEvent[]
  auditLog         AuditLog[]
  aiRuns           AiRun[]
  aiConversations  AiConversation[]
  documentLinks    DocumentLink[]
  calendarAccounts CalendarAccount[]
  comments         Comment[]
  invitations      Invitation[]
  agentWrites      AgentWriteJournal[]
  settings         WorkspaceSetting[]
  credentials      WorkspaceCredential[]
  automations      AutomationRule[]
  automationRuns   AutomationRun[]
  renderTemplates  RenderTemplate[]
  renderJobs       RenderJob[]
  projectBuilds    ProjectBuild[]

  @@index([isMemory])
  @@map("workspace")
}

/// One workspace's override of a runtime setting (issue #52, ADR-023).
///
/// The fourth resolution layer: defaults < environment < `setting` <
/// `workspace_setting`. An absent row means "inherit", which is why there is
/// no nullable value column and no tombstone: unsetting an override deletes
/// the row, and the two states stay distinguishable without a sentinel.
///
/// Only keys whose `SETTING_SCOPES` entry is `workspace` may appear here. A
/// row for any other key is ignored while resolving rather than rejected, so
/// a key that loses its scope later cannot brick a workspace.
model WorkspaceSetting {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Raw JSON value, validated field by field against `settingsSchema` while
  /// resolving, exactly like the deployment-wide `setting` table.
  key         String
  value       Json
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   User?     @relation("WorkspaceSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([workspaceId, key])
  @@map("workspace_setting")
}

/// What a stored credential is for. One purpose today; the column is an enum
/// so a second one (a workspace's own image model, a webhook secret) is a
/// migration and not a free-form string nobody validates.
enum WorkspaceCredentialPurpose {
  AI_OPENROUTER
}

/// A workspace's own third-party credential, encrypted at rest (issue #52,
/// ADR-023).
///
/// Deliberately not a setting: ADR-013 says a setting is a preference and
/// never a credential, and `setting` is a plaintext JSON column that the
/// administration area reads back to the browser. The value here never leaves
/// the server: the API answers with `configured`, `hint` and `updatedAt`, and
/// only the worker decrypts, once per run, to make the provider call.
model WorkspaceCredential {
  id          String                     @id @default(cuid(2))
  workspaceId String
  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purpose     WorkspaceCredentialPurpose
  /// AES-256-GCM output, all three parts base64 (packages/auth/src/credential-cipher.ts).
  ciphertext  String
  iv          String
  authTag     String
  /// Which deployment key encrypted this, so a later rotation can re-encrypt
  /// row by row instead of invalidating the table.
  keyVersion  Int                        @default(1)
  /// The last four characters, the only part ever shown again. Empty for a
  /// secret too short to survive showing any of it.
  hint        String
  createdById String?
  createdBy   User?                      @relation("WorkspaceCredentialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  /// Renewed when a run actually paid with this key, so "configured" and "in
  /// use" can be told apart on screen.
  lastUsedAt  DateTime?

  @@unique([workspaceId, purpose])
  @@map("workspace_credential")
}

model WorkspaceMember {
  id          String        @id @default(cuid(2))
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentType {
  PAGE
  COLLECTION
  /// A project workspace (issue #43, ADR-027): a file tree, not prose. Its Yjs
  /// state holds paths and sources rather than a ProseMirror document, which is
  /// why materialization, the search index and the embeddings all branch here.
  PROJECT
}

/// How wide the page body is rendered. Presentation, not content: it changes no
/// canonical state, so it lives on the document row and not in the Yjs state.
enum DocumentLayout {
  /// 68ch reading measure.
  NARROW
  /// Roughly double the measure, for pages carrying tables.
  WIDE
  /// The whole available width. Default for databases.
  FULL
}

enum DatabasePropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  CHECKBOX
  URL
  EMAIL
  PHONE
  PERSON
  FILES
  CREATED_TIME
  UPDATED_TIME
  CREATED_BY
  UPDATED_BY
  // Reserved for a later round: the enum values exist now so implementing
  // relations/rollups/formulas will not require another destructive migration.
  RELATION
  ROLLUP
  FORMULA
}

enum DatabaseViewType {
  TABLE
  BOARD
  GALLERY
  CALENDAR
}

/// AI rule pages (D5): a rule is a Document, not a parallel model, so it keeps
/// the tree, order key, search index, trash and workspace authorization the
/// Document model already provides.
enum AiRuleMode {
  /// Not a rules page.
  OFF
  /// The page body is appended to the system prompt of every run in this workspace.
  ALWAYS
  /// Only `aiRuleTrigger` reaches the system prompt; the model must call
  /// `exo_rules_load` to read the body (instruction redirect).
  ON_DEMAND
}

/// Overview pages (issue #53, ADR-028): a page whose text about its sub-pages is
/// composed rather than written. The mode sits on the document because being an
/// overview is a property of the page, not a rule somebody configured beside it.
enum OverviewMode {
  /// An ordinary page. Nothing is composed and nothing is digested.
  OFF
  /// The page lists its children and, when a model is available, opens with a
  /// composed paragraph. Its children get a digest so it can quote them.
  AUTO
}

model Document {
  id          String         @id @default(cuid(2))
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Document?      @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Document[]     @relation("DocumentHierarchy")
  type        DocumentType   @default(PAGE)
  title       String
  /// Either a literal character (an emoji) or `lucide:<name>` from the curated
  /// set in `@exocortex/contracts`. One field for both, because a page has one
  /// symbol; see `DOCUMENT_ICON_NAMES`.
  icon        String?
  /// Colour of a drawn `lucide:` icon, one of `DOCUMENT_ICON_COLORS`. Left as a
  /// plain string rather than an enum so adding a palette entry does not need a
  /// database migration; the contract validates it. `null` inherits the
  /// surrounding text colour, and an emoji ignores it.
  iconColor   String?
  /// Body width of the page. See `DocumentLayout`.
  layout      DocumentLayout @default(NARROW)

  /// Cover image shown above the title. An ordinary image attachment, so the
  /// upload, the magic-byte check and the access control are the ones the
  /// attachment module already owns. Hard-deleting the attachment clears the
  /// reference instead of leaving a broken image behind.
  coverAttachmentId String?
  coverAttachment   Attachment? @relation("DocumentCover", fields: [coverAttachmentId], references: [id], onDelete: SetNull)
  /// Vertical crop of the cover, in percent of the image height: 0 shows the
  /// top edge, 100 the bottom, 50 the middle. The cover is always full width
  /// at a fixed height, so this is the only framing decision there is.
  coverPosition     Float       @default(50)
  /// Fractional index (base62). Lets a document be inserted between two
  /// siblings without renumbering the rest of the tree.
  ///
  /// The column uses the `C` collation (see migration
  /// 20260804101500_order_key_c_collation) so comparisons use byte order, which
  /// is what the fractional index algorithm assumes.
  orderKey          String
  createdById       String
  createdBy         User        @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  updatedById       String
  updatedBy         User        @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  archivedAt        DateTime?

  /// AI rule flags (D5). `OFF` is the default so no existing page becomes a
  /// rule by accident.
  aiRuleMode     AiRuleMode @default(OFF)
  /// One-line German description of when this page applies. Required for
  /// ON_DEMAND: it is the only thing the model sees until it loads the page.
  aiRuleTrigger  String?
  /// Lower runs first when several ALWAYS rule pages exist.
  aiRulePriority Int        @default(100)

  /// Whether this page is an overview of its sub-pages (issue #53, ADR-028).
  /// `OFF` is the default, so no existing page starts composing by accident.
  overviewMode OverviewMode @default(OFF)

  /// Whether this page is the workspace's inbox (issue #71, ADR-036). Quick
  /// capture files into it and it is an ordinary page in every other respect:
  /// renamable, movable, searchable, deletable. One per workspace, kept by a
  /// partial unique index the migration creates by hand. Prisma cannot describe
  /// a partial index and does not report one either, so nothing about it shows
  /// up here or in the migration gate's diff.
  isInbox Boolean @default(false)

  /// Present when this page is a template other pages are copied from (issue
  /// #79, ADR-039). The sidecar carries only what a copy needs and a page
  /// cannot hold; the page itself stays an ordinary page.
  template         DocumentTemplate?  @relation("DocumentTemplatePage")
  /// Templates that suggest this page as the place their copies land.
  templateTargetOf DocumentTemplate[] @relation("DocumentTemplateTarget")

  content     DocumentContent?
  digest      DocumentDigest?
  snapshots   DocumentSnapshot[]
  searchIndex DocumentSearchIndex?
  embeddings  DocumentEmbedding[]
  attachments Attachment[]
  aiRuns      AiRun[]

  /// Present when `type` is COLLECTION: the property and view definitions of
  /// this database.
  databaseProperties  DatabaseProperty[]        @relation("CollectionProperties")
  databaseViews       DatabaseView[]            @relation("CollectionViews")
  /// Present when this document is a row (a PAGE child of a COLLECTION).
  propertyValues      DocumentPropertyValue[]   @relation("RowPropertyValues")
  /// Page a conversation was opened from. Context only.
  aiConversations     AiConversation[]          @relation("AiConversationDocument")
  /// References this page makes, and references other pages make to it.
  outgoingLinks       DocumentLink[]            @relation("DocumentLinkSource")
  incomingLinks       DocumentLink[]            @relation("DocumentLinkTarget")
  /// Present when this COLLECTION mirrors a remote calendar.
  calendarLinks       CalendarLink[]            @relation("CalendarLinkTarget")
  /// Present when this row mirrors one remote calendar object.
  calendarObject      CalendarObjectState[]     @relation("CalendarRow")
  /// Remarks about this page. Not part of its content (see `Comment`).
  comments            Comment[]                 @relation("DocumentComments")
  /// Present when `type` is PROJECT: the project's settings, files and builds
  /// (issue #43, ADR-027).
  project             Project?                  @relation("ProjectDocument")
  /// Present when this page *is* a distilled memory fact (issue #46).
  memoryFact          MemoryFact?               @relation("MemoryFactPage")
  /// Present when this page is a session note a consolidation run has read.
  memoryConsolidation MemoryConsolidation?      @relation("MemoryConsolidationNote")
  /// Facts this session note is evidence for.
  memoryFactSources   MemoryFactSource[]        @relation("MemoryFactSourceNote")
  /// Present when this page is an entity row: the pages that talk about it
  /// (issue #47).
  entityMentions      EntityMention[]           @relation("EntityMentionEntity")
  /// Entities this page talks about.
  mentionedEntities   EntityMention[]           @relation("EntityMentionPage")
  /// Names on this page that no entity answers to yet.
  entitySightings     EntityCandidateSighting[] @relation("EntityCandidateSightingPage")
  /// Present when a rule is scoped to this page's subtree or database.
  automationScopes    AutomationRule[]          @relation("AutomationScopeDocument")
  /// Automation runs this page triggered.
  automationRuns      AutomationRun[]           @relation("AutomationRunDocument")
  /// Builds of this page into a file (issue #44).
  renderJobs          RenderJob[]               @relation("RenderJobDocument")

  @@index([workspaceId, parentId, orderKey])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, aiRuleMode])
  @@index([workspaceId, overviewMode])
  @@index([coverAttachmentId])
  @@map("document")
}

model DocumentContent {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Canonical collaborative state. Never rebuilt from derived data.
  yjsState        Bytes
  schemaVersion   Int       @default(1)
  /// Timestamp of the last binary Yjs write. Used for job idempotency.
  yjsUpdatedAt    DateTime  @default(now())
  /// Derived representations. All of them are rebuilt by materialization.
  proseMirrorJson Json?
  plainText       String?
  markdown        String?
  materializedAt  DateTime?
  /// When `DocumentLink` was last rebuilt from this content. `null` marks a row
  /// the reference index has never seen, which is exactly what the
  /// `backfill-document-links` maintenance task looks for; a partial index on
  /// the column keeps that sweep cheap once the backfill is done.
  linksIndexedAt  DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([linksIndexedAt])
  @@map("document_content")
}

/// A page other pages are copied from (issue #79, ADR-039).
///
/// The sidecar, not the page. A template is an ordinary page and stays one, so
/// the editor, search, moving, renaming and deleting all work on it without a
/// second code path, and "turn this page into a template" is a row rather than
/// a conversion. What the row adds is the little a copy needs and a page has
/// nowhere to keep: the pattern the new title is built from, where the copy
/// should land, and how often this template is actually reached for.
model DocumentTemplate {
  documentId String   @id
  document   Document @relation("DocumentTemplatePage", fields: [documentId], references: [id], onDelete: Cascade)

  /// One line on when to reach for this template. The picker shows it under
  /// the title, which is the only place a template explains itself.
  description  String?
  /// What the copy is called, with `{{...}}` placeholders (see
  /// `renderTitlePattern` in `@exocortex/contracts`). Null names the copy after
  /// the template.
  titlePattern String?

  /// Where a copy lands when the caller names no parent. `SetNull` rather than
  /// `Cascade`, because deleting the suggested target should cost the
  /// suggestion and not the template.
  targetParentId String?
  targetParent   Document? @relation("DocumentTemplateTarget", fields: [targetParentId], references: [id], onDelete: SetNull)

  /// Usage, so the picker can offer what is actually used. Counted rather than
  /// derived: the copies are ordinary pages that keep no link back, which is
  /// the whole point of a template.
  useCount   Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetParentId])
  @@map("document_template")
}

/// Derived text about one page (issue #53, ADR-028).
///
/// Two halves that are produced together and kept apart. `summary` is what the
/// overview page above this one quotes; `intro` is what this page says about
/// its own children, and it is null unless the page is an overview.
///
/// Both carry the hash of what produced them, which is the whole staleness
/// mechanism: a refresh whose input hash is unchanged does nothing and costs
/// nothing, and a row whose hash no longer matches the live input is shown with
/// a "veraltet" badge rather than hidden. Nothing here is canonical; the row can
/// be deleted at any time and the next refresh rebuilds it.
model DocumentDigest {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Two or three sentences about this page. Null until a run produced one.
  summary          String?
  /// Hash of the material `summary` was composed from: this page's text.
  summaryInputHash String?
  summaryAt        DateTime?

  /// The paragraph this page's overview opens with. Null unless the page is an
  /// overview, and null on an overview whose composition has not run yet, which
  /// is the state that renders as the plain child list.
  intro          String?
  /// Hash of the material `intro` was composed from: the ordered child ids,
  /// titles and summary hashes. A deleted child changes this the same way an
  /// edited one does, which is the point.
  introInputHash String?
  introAt        DateTime?

  /// Model slug of the last successful run, for the footer and for debugging a
  /// composition that reads oddly.
  model String?

  /// Why the last run did not produce anything, cleared by the next one that
  /// does. A failure is never a reason to drop what is already there: an
  /// overview from yesterday beats an empty page.
  lastError    String?
  failedAt     DateTime?
  /// Whether a cover has already been offered for this page, so an overview
  /// gets its picture once rather than on every refresh (ADR-028).
  coverAskedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_digest")
}

enum SnapshotReason {
  MANUAL
  SCHEDULED
  PRE_RESTORE
  IMPORT
  RESTORE
  /// Taken before any programmatic content overwrite (D8), e.g.
  /// POST /api/documents/:id/content.
  API_WRITE
}

model DocumentSnapshot {
  id            String         @id @default(cuid(2))
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  yjsState      Bytes
  schemaVersion Int            @default(1)
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reason        SnapshotReason
  createdAt     DateTime       @default(now())

  @@index([documentId, createdAt])
  @@map("document_snapshot")
}

/// Search projection maintained by the `search-indexing` queue.
/// `searchVector` is a generated tsvector maintained through raw SQL because
/// Prisma has no native tsvector type.
model DocumentSearchIndex {
  documentId   String                   @id
  document     Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspaceId  String
  title        String
  plainText    String
  archivedAt   DateTime?
  updatedAt    DateTime                 @updatedAt
  searchVector Unsupported("tsvector")?

  @@index([workspaceId])
  @@map("document_search_index")
}

/// Semantic search projection (issue #34, AP4). One row per document and model:
/// `blockId` stays null until per-block chunking exists. Written and read
/// through raw SQL in `semantic-search.ts`, because Prisma has no vector type.
/// `textHash` is what keeps re-indexing an unchanged page free.
model DocumentEmbedding {
  id         String                       @id @default(cuid(2))
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// `NULL` for the vector of the whole page. A passage of a long page carries
  /// `chunk:0000`, `chunk:0001` and so on (issue #36, see `chunkBlockId`).
  blockId    String?
  model      String
  embedding  Unsupported("vector(1536)")?
  textHash   String?
  /// The passage this vector was built from, so a hit can show the paragraph
  /// that matched instead of the first 200 characters of the page. `NULL` on a
  /// whole-document row, which has the search index for that.
  chunkText  String?
  createdAt  DateTime                     @default(now())

  @@unique([documentId, blockId, model])
  @@index([documentId])
  @@map("document_embedding")
}

/// Which notation produced a reference. See `DOCUMENT_LINK_KINDS` in
/// `@exocortex/editor`; the contract carries the same three values in camelCase.
enum DocumentLinkKind {
  PAGE_LINK
  MENTION
  WIKI_MARK
}

/// Reference from one page to another, rebuilt by materialization.
///
/// Derived data, like `plainText` and `DocumentSearchIndex`: the truth stays in
/// the document content, and the rows of a source page are replaced wholesale
/// on every materialization so a deleted reference disappears (ADR-007).
///
/// `targetDocumentId` is nullable because a reference addresses a **title**,
/// not an identity (issue #14): it is null while no page carries that title,
/// and it is re-pointed when one is created or renamed. `targetTitleKey` is the
/// normalized title the resolution compares on, so a rename is two indexed
/// statements rather than a scan of every document's content.
model DocumentLink {
  id          String    @id @default(cuid(2))
  /// Denormalized from the source document: resolution is workspace-scoped and
  /// must not join the whole document table to find that out.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceDocumentId String
  sourceDocument   Document  @relation("DocumentLinkSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  /// `SetNull`, not `Cascade`: deleting the target turns the reference into an
  /// unresolved one, which is exactly what it has become.
  targetDocumentId String?
  targetDocument   Document? @relation("DocumentLinkTarget", fields: [targetDocumentId], references: [id], onDelete: SetNull)

  /// Identity the reference itself carries (`pageLink.documentId`,
  /// `mention.id`), copied out of the document as written. Not a foreign key on
  /// purpose: it must survive the target being deleted, so that a page written
  /// again under the same id keeps its incoming references, and so that the
  /// resolution can tell "the identity is gone" from "there never was one".
  /// `targetDocumentId` above stays the *resolved* pointer.
  targetHintId   String?
  /// Title as written, whitespace-normalized. Always present.
  targetTitle    String
  /// `targetTitle` lowercased. Kept as a column so the resolution can use an index.
  targetTitleKey String
  kind           DocumentLinkKind
  /// Addressable block the reference sits in, when it carries an identifier.
  blockId        String?
  /// Surrounding sentence, for the backlink preview.
  context        String
  /// Order of appearance in the source document.
  position       Int              @default(0)
  createdAt      DateTime         @default(now())

  /// One row per notation, title and block. The extractor deduplicates on the
  /// same triple, so this constraint only ever catches a bug — the wholesale
  /// replacement inside one transaction is what actually keeps the table clean.
  @@unique([sourceDocumentId, kind, targetTitleKey, blockId])
  /// "Who links to this page?"
  @@index([targetDocumentId])
  /// Resolution after a page is created or renamed.
  @@index([workspaceId, targetTitleKey])
  /// Resolution by identity, which is what a rename no longer has to touch.
  @@index([targetHintId])
  @@index([sourceDocumentId, position])
  @@map("document_link")
}

/// A remark *about* a page, which is not part of the page (issue #18).
///
/// Deliberately outside the Yjs state: a comment that lived in the document
/// would be captured by every snapshot and thrown away again by every restore,
/// and it would travel in a Markdown export as if it were content. It lives
/// here instead and reaches open editors over the application socket (ADR-008).
///
/// A thread is one root plus its replies, one level deep. Notion works the same
/// way, and a tree buys nothing a panel this narrow can render.
model Comment {
  id          String    @id @default(cuid(2))
  /// Denormalized from the document: events are emitted into the workspace
  /// room, and neither that nor the authorization check should have to join
  /// the document table to find out which workspace this belongs to.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document  @relation("DocumentComments", fields: [documentId], references: [id], onDelete: Cascade)

  /// The thread this comment answers. `null` makes it the root of one.
  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  /// Addressable block the thread hangs on (`@exocortex/editor`'s block
  /// identifiers, which survive rewording). `null` is a comment on the page as
  /// a whole. Deliberately not a foreign key: there is no block table, and the
  /// comment has to outlive the block it names -- see `orphanedAt`.
  blockId    String?
  /// The anchored block's text at the moment the thread was opened, shortened.
  /// Kept so an orphaned thread still says what it was about.
  anchorText String?
  /// Set by materialization when the document no longer contains `blockId`.
  /// Derived data, like the reference index: cleared again when the block comes
  /// back (an undo does that). The comment itself is never deleted for it.
  orphanedAt DateTime?

  body        String
  createdById String
  createdBy   User      @relation("CommentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set the first time the author rewrites the body, so the UI can say so.
  editedAt    DateTime?

  /// Resolved threads are collapsed, never deleted: the discussion is the
  /// record of why the page reads the way it does.
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("CommentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// The panel's own query: every thread of a page, oldest first.
  @@index([documentId, createdAt])
  /// "Which blocks of this page carry a thread?" — the editor's markers.
  @@index([documentId, blockId])
  @@index([parentId])
  @@index([workspaceId])
  @@index([createdById])
  @@map("comment")
}

// ---------------------------------------------------------------------------
// Databases (Notion-style typed collections)
//
// A database is a Document with type COLLECTION. Its rows are ordinary
// Document children (type PAGE) — a row is a fully editable page, and reuses
// the tree, orderKey, search index, trash and workspace authorization the
// Document model already has. See ADR-011.
// ---------------------------------------------------------------------------

model DatabaseProperty {
  id         String               @id @default(cuid(2))
  documentId String
  document   Document             @relation("CollectionProperties", fields: [documentId], references: [id], onDelete: Cascade)
  type       DatabasePropertyType
  name       String
  /// Fractional index, byte-ordered like `Document.orderKey` (the column uses
  /// the `C` collation, see migration 20260806190000_database_order_key_c_collation).
  orderKey   String
  /// Type-specific, non-filterable configuration (number display format,
  /// whether a DATE property includes time-of-day). Never used for
  /// SELECT/MULTI_SELECT options — those are DatabasePropertyOption rows so
  /// renaming an option never rewrites every row's value.
  config     Json?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  options DatabasePropertyOption[]
  values  DocumentPropertyValue[]

  @@unique([documentId, name])
  @@index([documentId, orderKey])
  @@map("database_property")
}

model DatabasePropertyOption {
  id         String           @id @default(cuid(2))
  propertyId String
  property   DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  /// One of the nine content-colour token names in packages/ui/src/tokens.css
  /// (gray/brown/orange/yellow/green/blue/purple/pink/red), never a hex value.
  color      String
  /// Fractional index, byte-ordered like `Document.orderKey` (the column uses
  /// the `C` collation, see migration 20260806190000_database_order_key_c_collation).
  orderKey   String
  createdAt  DateTime         @default(now())

  @@unique([propertyId, label])
  @@index([propertyId, orderKey])
  @@map("database_property_option")
}

model DatabaseView {
  id                String           @id @default(cuid(2))
  documentId        String
  document          Document         @relation("CollectionViews", fields: [documentId], references: [id], onDelete: Cascade)
  type              DatabaseViewType
  name              String
  /// Fractional index, byte-ordered like `Document.orderKey` (the column uses
  /// the `C` collation, see migration 20260806190000_database_order_key_c_collation).
  orderKey          String
  /// Structured filter tree, validated against databaseFilterGroupSchema
  /// before it ever reaches the query engine. Never free-form SQL or JS.
  filters           Json             @default("[]")
  sorts             Json             @default("[]")
  /// Board's columns / optional Gallery grouping. Null means ungrouped.
  groupByPropertyId String?
  /// Visible/ordered property list plus view-specific settings (Calendar's
  /// date property id, Gallery's cover property id).
  config            Json             @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  aiRuns AiRun[]

  @@unique([documentId, name])
  @@index([documentId, orderKey])
  @@map("database_view")
}

/// One row per (row document, property) pair. Typed columns rather than a
/// JSONB blob so Table/Board/Calendar/Gallery views can filter and sort with
/// indexed SQL instead of scanning and parsing a blob per row.
model DocumentPropertyValue {
  id         String           @id @default(cuid(2))
  documentId String
  document   Document         @relation("RowPropertyValues", fields: [documentId], references: [id], onDelete: Cascade)
  propertyId String
  property   DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// TEXT, URL, EMAIL, PHONE, and the selected option id for SELECT.
  textValue    String?
  numberValue  Decimal?  @db.Decimal(20, 6)
  boolValue    Boolean?
  /// DATE: the instant, and the *start* of the span when the property has
  /// `isRange: true`. Always UTC; the authoring zone is on the property config.
  dateValue    DateTime?
  /// DATE with `isRange: true` only: exclusive end of the span. Null means the
  /// span has no stated end, which is not the same as a zero-length one.
  dateEndValue DateTime?
  /// DATE only: whether the span covers whole days rather than a time of day.
  /// Per value, not per property -- one calendar holds birthdays and 14:00
  /// meetings. Null for a property that has never been written as all-day.
  dateAllDay   Boolean?
  /// Arrays only: MULTI_SELECT (option ids), PERSON (user ids), FILES
  /// (attachment ids). Never used for the scalar types above.
  jsonValue    Json?

  updatedAt DateTime @updatedAt

  @@unique([documentId, propertyId])
  @@index([documentId])
  @@index([propertyId, textValue])
  @@index([propertyId, numberValue])
  @@index([propertyId, dateValue])
  @@index([propertyId, boolValue])
  /// Serves the `overlaps` filter, which reads both ends of a span.
  @@index([propertyId, dateValue, dateEndValue])
  @@map("document_property_value")
}

// ---------------------------------------------------------------------------
// Attachments
// ---------------------------------------------------------------------------

/// Text extraction state machine (D6). Extraction runs in the worker and
/// caches its result here so a repeat read of the same attachment is free.
enum AttachmentTextStatus {
  /// The MIME type has no text layer we extract (images, video, audio).
  NOT_APPLICABLE
  PENDING
  READY
  FAILED
}

model Attachment {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  filename    String
  /// MIME type detected from the file magic bytes, not from the browser.
  mimeType    String
  byteSize    Int
  /// Server-generated object key. Clients never choose storage keys.
  storageKey  String    @unique
  checksum    String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  /// Set by the cover upload route: this file was uploaded to be a page cover
  /// and nothing else points at it. That is what lets maintenance delete it
  /// once it stops being one; an image a user placed in the body is never
  /// marked and is never collected.
  isCover Boolean    @default(false)
  coverOf Document[] @relation("DocumentCover")

  /// Downscaled copy of an image, stored next to the original so a page view
  /// does not have to pull a 12-megapixel photo to draw a cover. Derived data:
  /// null simply means "serve the original", and the three columns are always
  /// written and cleared together.
  previewKey      String? @unique
  previewMimeType String?
  previewByteSize Int?

  /// Extracted text cache (D6). Populated by the `attachment-text` queue.
  extractedText       String?
  textStatus          AttachmentTextStatus @default(NOT_APPLICABLE)
  textExtractedAt     DateTime?
  textExtractionError String?
  /// What the extraction engines could tell about the document: the PDF's own
  /// title, author and dates plus page, table and picture counts. Shaped by
  /// `pdfMetadataSchema`; a Json column because the fields are engine-reported
  /// and open-ended, and none of them is ever queried or filtered on.
  textMetadata        Json?
  /// True when the last successful extraction was longer than
  /// `ATTACHMENT_TEXT_MAX_CHARS` and got cut off (issue #2). Reset on every new
  /// extraction so a stale flag never survives a shorter re-read.
  textTruncated       Boolean              @default(false)

  /// Human correction of `extractedText` (issue #2), kept in a column of its
  /// own rather than overwriting the machine result: a later re-extraction must
  /// never silently discard what a person fixed by hand, and keeping both lets
  /// the UI show that they differ. Whenever present, this is the version every
  /// reader (human or `exo_attachment_read_text`) sees.
  correctedText     String?
  textCorrectedAt   DateTime?
  textCorrectedById String?
  textCorrectedBy   User?          @relation("AttachmentTextCorrectedBy", fields: [textCorrectedById], references: [id], onDelete: SetNull)
  /// Present when this file is the artifact of a render (issue #44).
  renderJobs        RenderJob[]    @relation("RenderJobArtifact")
  /// Present when this file sits in a project's file tree (issue #43).
  projectFiles      ProjectFile[]
  /// Present when this file is the PDF a project build produced.
  projectBuildPdfs  ProjectBuild[] @relation("ProjectBuildArtifact")
  /// Present when this file is the SyncTeX map a project build produced.
  projectBuildMaps  ProjectBuild[] @relation("ProjectBuildSourceMap")

  @@index([workspaceId, createdAt])
  @@index([documentId])
  /// Covers are a small minority of all attachments, and the maintenance sweep
  /// asks for exactly them.
  @@index([isCover])
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Transactional infrastructure
// ---------------------------------------------------------------------------

/// Transactional outbox: domain events written in the same transaction as the
/// state change they describe, then dispatched by the maintenance queue.
model OutboxEvent {
  id            String    @id @default(cuid(2))
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type          String
  payload       Json
  correlationId String
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  /// The automation rule whose action caused this write, when one did
  /// (issue #50, ADR-024). Set from a header the API accepts only on a service
  /// token, so a rule cannot be silenced by anybody who can reach the API.
  ///
  /// A plain column rather than a relation: the whole point is that the
  /// dispatcher can read the origin of an event whose rule has since been
  /// deleted, and a cascade would take exactly those rows away.
  automationRuleId String?
  /// How many automations deep the write was. `AUTOMATION_MAX_DEPTH` is where
  /// the chain stops firing further rules.
  automationDepth  Int     @default(0)

  @@index([processedAt, createdAt])
  @@map("outbox_event")
}

/// Audit trail for destructive and permission-relevant operations.
/// Must never contain document contents or secrets.
model AuditLog {
  id            String    @id @default(cuid(2))
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  targetType    String
  targetId      String
  metadata      Json?
  correlationId String
  createdAt     DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// AI model registry
// ---------------------------------------------------------------------------

/// Thinking/effort levels a model accepts for OpenRouter's `reasoning`
/// parameter. NONE means the parameter is omitted entirely. Declared in
/// ascending strength: XHIGH and MAX exist because the provider started
/// reporting them (`reasoning.supported_efforts`), not because every model
/// offers them -- what a given model actually accepts is `AiModel.reasoningLevels`.
enum AiReasoningLevel {
  NONE
  MINIMAL
  LOW
  MEDIUM
  HIGH
  XHIGH
  MAX
}

/// Admin-editable catalogue of selectable models. Seeded from the live
/// OpenRouter model endpoint and refreshable from it.
model AiModel {
  id                    String             @id @default(cuid(2))
  /// Provider-native identifier, e.g. `anthropic/claude-sonnet-5`.
  slug                  String             @unique
  /// `id` of the AiProvider that serves it ('openrouter', 'mock').
  provider              String             @default("openrouter")
  displayName           String
  /// Short German one-liner shown under the name in the picker.
  description           String?
  contextWindowTokens   Int
  maxOutputTokens       Int?
  supportsVision        Boolean            @default(false)
  supportsTools         Boolean            @default(false)
  /// Selectable thinking levels. Always contains NONE. A single-element array
  /// means the level is not user-selectable for this model.
  reasoningLevels       AiReasoningLevel[] @default([])
  /// Price in micro-USD per million tokens. Integer, so no float drift.
  inputMicroUsdPerMTok  Int
  outputMicroUsdPerMTok Int
  /// Vision companion used when `supportsVision` is false (ADR-012). This is
  /// the admin default; a user may override it per conversation.
  visionCompanionId     String?
  visionCompanion       AiModel?           @relation("VisionCompanion", fields: [visionCompanionId], references: [id], onDelete: SetNull)
  companionFor          AiModel[]          @relation("VisionCompanion")
  /// A disabled model stays resolvable for old conversations but leaves the picker.
  enabled               Boolean            @default(true)
  /// Ascending sort position in the picker. Plain integer: the list is ~20 rows.
  sortOrder             Int                @default(100)
  /// For an OpenRouter `~vendor/model-latest` alias: the model it resolved to at
  /// the last sync. The slug stays the alias, so the alias keeps moving with the
  /// family; this only says what its figures and endpoints describe (ADR-032).
  aliasTargetSlug       String?
  /// When the endpoint snapshot below was last refreshed successfully. An old
  /// timestamp means stale, and stale data is kept rather than deleted.
  endpointsSyncedAt     DateTime?
  /// Set when the snapshot is known to describe something else -- today only
  /// when an alias answered as a different model than it last resolved to. The
  /// scheduled refresh takes these first, and clears the mark when it succeeds.
  endpointsStaleSince   DateTime?
  /// Raw OpenRouter metadata from the last sync. Never read at runtime.
  metadata              Json?
  syncedAt              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  conversations AiConversation[]
  endpoints     AiModelEndpoint[]

  @@index([enabled, sortOrder])
  @@map("ai_model")
}

/// One provider's offer for one model (ADR-032).
///
/// A model on OpenRouter is served by many providers at once, and they differ in
/// context window, output limit, price and capabilities. The registry keeps a
/// snapshot of them so a request can be restricted to the providers that can
/// actually serve it, instead of collapsing the differences into one number.
model AiModelEndpoint {
  id                      String   @id @default(cuid(2))
  modelId                 String
  model                   AiModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  /// The routing key OpenRouter accepts in `provider.only`, verbatim from the
  /// endpoint's `tag` (e.g. `reka/fp8`). Never derived from the display name.
  providerKey             String
  providerName            String
  /// Slug the snapshot describes: the alias target for an alias row, else the model's own slug.
  targetSlug              String
  contextWindowTokens     Int
  /// Separate cap on the input alone; null where the endpoint states none.
  maxPromptTokens         Int?
  maxOutputTokens         Int?
  inputMicroUsdPerMTok    Int
  outputMicroUsdPerMTok   Int
  supportsTools           Boolean  @default(false)
  supportsReasoningEffort Boolean  @default(false)
  quantization            String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([modelId, providerKey])
  @@index([modelId, contextWindowTokens])
  @@map("ai_model_endpoint")
}

// ---------------------------------------------------------------------------
// Persistent AI conversations
// ---------------------------------------------------------------------------

enum AiConversationRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

model AiConversation {
  id                  String           @id @default(cuid(2))
  workspaceId         String
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById         String
  createdBy           User             @relation("AiConversationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  /// German title, derived from the first user message. Renameable.
  title               String
  /// Page the conversation is currently standing on. Rebound whenever a turn
  /// arrives from a different page, which also writes a marker into the
  /// transcript (see `ConversationsService.postMessage`).
  documentId          String?
  document            Document?        @relation("AiConversationDocument", fields: [documentId], references: [id], onDelete: SetNull)
  /// Whether the open page is disclosed to the model at all. `documentId` keeps
  /// tracking where the user is either way: this only decides what leaves.
  /// Toggled by the context chip and by `/context`.
  pageContextEnabled  Boolean          @default(true)
  modelId             String?
  model               AiModel?         @relation(fields: [modelId], references: [id], onDelete: SetNull)
  reasoningLevel      AiReasoningLevel @default(NONE)
  /// User override of the model's admin-configured vision companion.
  /// `null` means "use the admin default", the literal string 'off' disables it.
  visionCompanionSlug String?
  /// Running estimate of the tokens the active messages occupy. Drives
  /// auto-compaction against the selected model's context window.
  estimatedTokens     Int              @default(0)
  lastMessageAt       DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  archivedAt          DateTime?

  messages AiConversationMessage[]
  runs     AiRun[]

  @@index([workspaceId, createdById, lastMessageAt])
  /// The `/chats` listing spans every workspace the person is a member of and
  /// filters by creator alone, so the index above -- which leads with the
  /// workspace -- cannot serve it (issue #69).
  @@index([createdById, lastMessageAt(sort: Desc)])
  @@map("ai_conversation")
}

model AiConversationMessage {
  id              String                   @id @default(cuid(2))
  conversationId  String
  conversation    AiConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            AiConversationRole
  content         String
  /// Assistant tool-call requests, verbatim as the provider returned them.
  /// Null for plain text turns.
  toolCalls       Json?
  /// Set on TOOL messages: which call this is the result of.
  toolCallId      String?
  toolName        String?
  /// True when a compaction produced this message instead of a user or model.
  isSummary       Boolean                  @default(false)
  /// Set when a compaction or `/clear` retired this message. Retired messages
  /// stay readable in the UI but never reach the provider again.
  supersededAt    DateTime?
  runId           String?
  estimatedTokens Int                      @default(0)
  createdAt       DateTime                 @default(now())
  /// Generated tsvector over `content`, maintained by PostgreSQL rather than by
  /// an indexing job: unlike a page, a message is already plain text when it is
  /// written, so there is nothing to materialize (issue #69). Raw SQL, because
  /// Prisma has no native tsvector type -- same arrangement as
  /// `DocumentSearchIndex.searchVector`.
  searchVector    Unsupported("tsvector")?

  @@index([conversationId, createdAt])
  @@index([conversationId, supersededAt])
  @@map("ai_conversation_message")
}

// ---------------------------------------------------------------------------
// AI runs
// ---------------------------------------------------------------------------

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

model AiRun {
  id             String        @id @default(cuid(2))
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId     String?
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  /// The view that was open when `documentId` points at a COLLECTION. A
  /// database's rows only mean something through a view's filters and sorts, so
  /// describing the page without it would describe a different table than the
  /// one on screen. Null for ordinary pages.
  databaseViewId String?
  databaseView   DatabaseView? @relation(fields: [databaseViewId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  status         AiRunStatus   @default(PENDING)
  provider       String
  model          String
  /// Prompt messages as submitted by the user. Never includes document
  /// content: image descriptions generated for this run (ADR-012) are
  /// prepended in memory before the provider call and are not persisted here.
  messages       Json
  resultText     String?
  usage          Json?
  errorCode      String?
  createdAt      DateTime      @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  cancelledAt    DateTime?
  /// Last sign of life from the worker processing this run, renewed every
  /// few seconds while it is RUNNING. A RUNNING run without a recent one has
  /// lost its worker (crash, deploy restart, stalled job) -- see
  /// reap-stale-ai-runs (apps/worker/src/processors/maintenance.ts).
  heartbeatAt    DateTime?

  /// Conversation this run belongs to, when it was started from one (D7).
  /// No `@map`: every other column on this model keeps Prisma's default
  /// camelCase-to-camelCase mapping (see e.g. `workspaceId`), so this one does
  /// too -- verified against the generated migration SQL.
  conversationId String?
  conversation   AiConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reasoningLevel AiReasoningLevel @default(NONE)
  /// Number of tool round-trips this run performed.
  toolIterations Int              @default(0)

  /// The usage figures as columns rather than only inside `usage` (issue #10).
  /// The JSON stays for provider-specific extras; these are what every usage
  /// question groups over, and a JSON cast per row is neither pleasant to write
  /// nor fast enough for a breakdown by model, day and status. Nullable
  /// throughout: a run that never reached the provider reports no usage at all,
  /// and zero would claim it did.
  inputTokens           Int?
  outputTokens          Int?
  cachedInputTokens     Int?
  /// Cost exactly as the provider reported it. Null means it reported none,
  /// which is not the same as free -- see `estimatedCostMicroUsd`.
  providerCostMicroUsd  Int?
  /// Cost computed from the model registry's prices at the time of the run,
  /// filled only when the provider reported nothing. Deliberately a second
  /// column rather than a fallback written into the first one, so a total can
  /// still say how much of it was measured and how much was arithmetic.
  estimatedCostMicroUsd Int?
  durationMs            Int?
  /// Whether this run was paid for with the workspace's own provider key
  /// rather than the deployment's (issue #52, ADR-023). A column and not a
  /// join, because the credential may be replaced or removed later and the
  /// usage report still has to say whose money this run spent.
  usedOwnKey            Boolean @default(false)

  /// When the retention sweep emptied `messages` and `resultText`. The metric
  /// columns above survive it, so a pruned run still counts in the statistics
  /// and the API can say the texts are gone instead of implying there were none.
  payloadsPrunedAt DateTime?

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  /// The deployment-wide usage view filters on time alone, across every
  /// workspace, so neither index above can serve it.
  @@index([createdAt])
  /// Not for querying runs by view -- so deleting a view does not have to scan
  /// every run to apply the SET NULL.
  @@index([databaseViewId])
  /// reap-stale-ai-runs scans exactly this pair.
  @@index([status, heartbeatAt])
  @@map("ai_run")
}

// ---------------------------------------------------------------------------
// Calendar synchronisation
// ---------------------------------------------------------------------------

/// Which protocol reaches a calendar account.
enum CalendarProvider {
  /// CalDAV. mailbox.org, Nextcloud, Radicale, anything standards-compliant.
  CALDAV
  /// Reserved: Google Calendar API v3. Google's own CalDAV is second-class and
  /// gives no push channel, so it gets its own provider rather than pretending
  /// to be CALDAV.
  GOOGLE
}

/// How far a link is allowed to write.
enum CalendarSyncDirection {
  /// Read the remote side into Exocortex. Never writes outward.
  PULL
  /// Reserved for the write-back round.
  PUSH
  BOTH
}

/// Where an event was born, and therefore who is allowed to change it.
enum CalendarEventOrigin {
  /// Created in Exocortex. Exocortex is leading and may rewrite it.
  LOCAL
  /// Created outside: in the mail app, in another client, or by accepting an
  /// iCal invitation. Rewriting the time of one of these would send an ITIP
  /// counter-proposal to the organizer, so a PULL link never does.
  REMOTE
}

/// One remote calendar account. Credentials are NOT here: the columns below are
/// identifiers, and `credentialRef` only names the environment key that holds
/// the secret (source of truth is Infisical, see deploy/README.md). The
/// `setting` table is not encrypted, so a password may never land in the
/// database at all.
model CalendarAccount {
  id            String           @id @default(cuid(2))
  workspaceId   String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The human the sync acts as. Every row it writes goes through the REST API
  /// with a service token minted for this user, so the mirror can reach exactly
  /// the pages they could reach and no more (ADR-014). On the account rather than
  /// in the job payload, because a repeatable schedule has no user context.
  userId        String
  user          User             @relation("CalendarAccountOwner", fields: [userId], references: [id], onDelete: Cascade)
  provider      CalendarProvider
  /// Label shown in the UI, e.g. "mailbox.org".
  displayName   String
  /// The login as the provider knows it. Also matched against ATTENDEE to read
  /// our own participation status out of an invitation.
  username      String
  /// Name of the env key holding the credentials, e.g. `MAILBOX_CALDAV_PASSWORD`.
  /// Indirection on purpose: rotating the secret never touches this row.
  credentialRef String
  /// Entry point for discovery. Null falls back to the provider's default.
  baseUrl       String?
  enabled       Boolean          @default(true)
  lastSyncedAt  DateTime?
  /// Last failure, kept so the UI can say why a calendar is stale.
  lastError     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  links CalendarLink[]

  @@unique([workspaceId, provider, username])
  // Declared here because the migration creates it. Without the declaration the
  // index exists in the database and not in the model, and the next
  // `migrate dev` would offer to drop it.
  @@index([userId])
  @@map("calendar_account")
}

/// One remote collection mirrored into one Exocortex database.
model CalendarLink {
  id                     String                @id @default(cuid(2))
  accountId              String
  account                CalendarAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The remote collection's path, e.g. `/caldav/Y2FsOi8vMC8yNQ/`. Its identity.
  remoteHref             String
  /// The name the server gives it, refreshed on every discovery run.
  remoteDisplayName      String
  /// `VEVENT` or `VTODO`. A collection can advertise both; a link handles one.
  component              String                @default("VEVENT")
  /// The COLLECTION document the rows live under (ADR-011).
  documentId             String
  document               Document              @relation("CalendarLinkTarget", fields: [documentId], references: [id], onDelete: Cascade)
  /// Which property receives which field. Validated against
  /// calendarLinkPropertyMapSchema in @exocortex/contracts, the same
  /// "JSON column validated at the boundary" pattern as DatabaseView.config.
  propertyMap            Json                  @default("{}")
  direction              CalendarSyncDirection @default(PULL)
  /// Last `sync-collection` token. Null means the next run reads everything.
  syncToken              String?
  /// False for a collection the server reports no sync-token for (mailbox.org's
  /// generated "Geburtstage"). Such a link can only ever be read in full, so it
  /// is polled far less often -- see the sync processor.
  supportsSyncCollection Boolean               @default(true)
  /// Cheap change detector for the collections above.
  ctag                   String?
  enabled                Boolean               @default(true)
  lastSyncedAt           DateTime?
  lastError              String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  objects CalendarObjectState[]

  @@unique([accountId, remoteHref, component])
  @@index([documentId])
  @@map("calendar_link")
}

/// What Exocortex knows about one remote calendar object, and which row mirrors
/// it. This is the table that makes the sync safe rather than lossy.
model CalendarObjectState {
  id              String              @id @default(cuid(2))
  linkId          String
  link            CalendarLink        @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// Path of the object on the server, e.g. `/caldav/…/abc.ics`.
  remoteHref      String
  /// Version as the server states it. Unchanged etag means the body need not be
  /// fetched at all, which is what keeps a routine sync cheap.
  etag            String?
  /// The iCalendar UID. Stable across servers, so the same invitation arriving
  /// in mailbox.org *and* in Google is recognised as one event instead of two.
  icsUid          String
  /// The row Document mirroring this object. Null while a mapping is pending or
  /// after the row was deleted by hand.
  rowDocumentId   String?
  row             Document?           @relation("CalendarRow", fields: [rowDocumentId], references: [id], onDelete: SetNull)
  origin          CalendarEventOrigin @default(REMOTE)
  /// Set when the object arrived as an invitation; then the organizer owns it.
  organizer       String?
  /// Our own PARTSTAT, e.g. ACCEPTED. Read-only until ITIP replies exist.
  partStat        String?
  /// The object's raw iCalendar body, stored only for recurring objects.
  ///
  /// A series' next occurrence changes as time passes, not when the object
  /// changes, and an unchanged etag means there is deliberately nothing to
  /// fetch. So the rule has to be readable locally, or "next Monday" would stay
  /// last Monday until someone edited the appointment.
  recurrenceIcs   String?
  /// Start of the occurrence currently written into the mirrored row. Lets a pass
  /// see at a glance whether the row still names the right date, and is what the
  /// reminder sweep reads instead of querying every row through the API.
  occurrenceStart DateTime?
  /// The occurrence a reminder has already gone out for.
  ///
  /// Compared against `occurrenceStart`, which makes the sweep idempotent for
  /// free: equal means "already announced", and an appointment that moves gets a
  /// fresh reminder because its start no longer matches. A boolean would have to
  /// be reset by hand on every change, and a series would only ever be announced
  /// once.
  remindedFor     DateTime?
  /// Hash of the payload last written outward, so a future two-way sync can tell
  /// "the remote changed" from "the remote is echoing our own write" and cannot
  /// ping-pong. Unused while the link is PULL.
  lastPushedHash  String?
  remoteUpdatedAt DateTime?
  lastSeenAt      DateTime            @default(now())
  /// Tombstone. Set when the object is gone from the server instead of deleting
  /// this row: with remote creation allowed, absence is no longer a delete
  /// signal, so the sync needs to remember that this UID *was* deleted or it
  /// will recreate it on the next full read.
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([linkId, remoteHref])
  /// Dedup and tombstone lookups both go by UID within a link.
  @@index([linkId, icsUid])
  @@index([rowDocumentId])
  /// The reminder sweep asks for "appointments around now", once a minute.
  @@index([occurrenceStart])
  @@map("calendar_object_state")
}

/// What a consolidation run decided about one fact.
///
/// `CURRENT` is what a recall answers with. `SUPERSEDED` is kept rather than
/// deleted because "this used to be true until the 14th" is itself an answer,
/// and because a superseded fact is the only evidence that the newer one is a
/// correction rather than a first sighting. `CONFLICTED` is the honest third
/// state: two notes disagree and nothing in the system knows which wins, so it
/// is marked and left for a human instead of resolved by coin toss.
enum MemoryFactStatus {
  CURRENT
  SUPERSEDED
  CONFLICTED
}

/// One distilled statement the agents' memory holds to be true (issue #46).
///
/// The wording lives in an ordinary page (`documentId`), which is what makes a
/// fact searchable, embeddable, versioned and readable by a human without a
/// single line of new rendering. This row is the metadata that a page cannot
/// carry: how sure we are, when it was last confirmed, and what replaced it.
///
/// It is deliberately *not* a database row in the ADR-011 sense. A `Document`
/// with `type: 'COLLECTION'` is a thing a person designs and rearranges; this
/// schema is fixed, written only by a background job, and read on the hot path
/// of every recall. A typed table is the honest shape for that.
model MemoryFact {
  id String @id @default(cuid(2))

  /// The page carrying the statement. One page, one fact: deleting the page
  /// deletes the fact, which is what makes the trash the undo button here too.
  documentId String   @unique
  document   Document @relation("MemoryFactPage", fields: [documentId], references: [id], onDelete: Cascade)

  /// Denormalized from the page. Facts are always read workspace-scoped, and
  /// resolving the workspace through the page on every recall would cost a join
  /// on the hot path. No relation: the row dies with its page anyway.
  workspaceId String
  /// Normalized project key, the same one `POST /api/memory/remember` files
  /// notes under. The unit a consolidation run works on.
  projectKey  String

  status MemoryFactStatus @default(CURRENT)

  /// Between 0 and 1. Raised by a confirmation, lowered by time (the
  /// `decay-memory-facts` sweep). Not a probability, a ranking weight: it
  /// decides what a recall shows first and what it stops showing at all.
  confidence      Float    @default(0.5)
  /// How many separate notes have said this. The reason a fact seen ten times
  /// outlives one seen once, whatever their ages.
  confirmations   Int      @default(1)
  firstSeenAt     DateTime @default(now())
  /// Last time a note said this again. What the decay measures against.
  lastConfirmedAt DateTime @default(now())

  /// The fact that replaced this one. Set together with `SUPERSEDED`.
  supersededById String?
  supersededBy   MemoryFact?  @relation("MemoryFactSuccession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     MemoryFact[] @relation("MemoryFactSuccession")

  /// Page in the curated brain this fact was promoted into, and when. A plain
  /// pointer rather than a relation: the brain is somebody's to reorganize and
  /// to delete from, and a dangling pointer there is a smaller problem than a
  /// cascade reaching out of the memory workspace into curated pages (ADR-019).
  promotedDocumentId String?
  promotedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources MemoryFactSource[]

  /// "The current facts of this project, best first" -- the recall query.
  @@index([workspaceId, projectKey, status, confidence])
  /// The decay sweep, which asks for facts nobody has confirmed in a while.
  @@index([status, lastConfirmedAt])
  @@index([supersededById])
  @@map("memory_fact")
}

/// A note that a consolidation run has already looked at.
///
/// The cursor of the whole mechanism, and the reason it needs no timestamp
/// bookkeeping of its own: a note without a row here is unread, a note with one
/// is done. A run that produced nothing still writes a row, or an unremarkable
/// note would be re-read, and re-paid for, every single night.
model MemoryConsolidation {
  id String @id @default(cuid(2))

  noteId String   @unique
  note   Document @relation("MemoryConsolidationNote", fields: [noteId], references: [id], onDelete: Cascade)

  /// How many facts this note produced or confirmed. Zero is a normal answer.
  factsProduced  Int      @default(0)
  consolidatedAt DateTime @default(now())

  @@map("memory_consolidation")
}

/// The note a fact was distilled from. Its evidence.
///
/// Kept as rows rather than as `[[wiki links]]` in the fact's body: a reference
/// addresses a title (issue #14) and two sessions on the same afternoon can
/// easily produce two notes called the same thing. Evidence has to point at an
/// identity or it is not evidence.
model MemoryFactSource {
  id String @id @default(cuid(2))

  factId String     @map("factId")
  fact   MemoryFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  noteId String   @map("noteId")
  note   Document @relation("MemoryFactSourceNote", fields: [noteId], references: [id], onDelete: Cascade)

  /// Whether this note created the fact or repeated it. A first sighting and a
  /// confirmation weigh differently when a human asks where a claim came from.
  confirming Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([factId, noteId])
  @@index([noteId])
  @@map("memory_fact_source")
}

// ---------------------------------------------------------------------------
// Agent provenance (ADR-022, issue #49)
// ---------------------------------------------------------------------------

/// One connection an agent held, for as long as it held it.
///
/// Snapshots and the activity trail are per page, and the question a person
/// asks about an agent is not: it is "what did this thing touch this
/// afternoon, and take all of it back". That question needs an identity that
/// outlives a single call, which no correlation id provides -- one request,
/// one correlation id, by design.
///
/// The id is chosen by the client and only ever trusted within one account:
/// `externalId` is unique *per user*, so naming somebody else's session id
/// lands in a row of one's own rather than in theirs.
model AgentSession {
  id String @id @default(cuid(2))

  /// The session id as the client knows it: minted by the stdio bin per
  /// process, or the `Mcp-Session-Id` of an HTTP connection.
  externalId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `clientInfo` from `initialize`, verbatim and unverified. Shown so a person
  /// recognises the agent that wrote, never used for a decision.
  clientLabel  String?
  /// 'stdio' or 'http'. Which transport carried the connection.
  transport    String?
  /// The API token or OAuth client behind it, for the admin view's "who".
  credentialId String?

  startedAt  DateTime @default(now())
  /// Moved forward by every journalled write, which is the only heartbeat
  /// there is: nothing tells this deployment that an agent has gone away.
  lastSeenAt DateTime @default(now())

  writes AgentWriteJournal[]

  @@unique([userId, externalId])
  @@index([lastSeenAt])
  @@map("agent_session")
}

/// One mutation, as it happened.
///
/// Deliberately no content: the snapshot the write already created holds the
/// previous state, and this row points at it. Duplicating bytes here would
/// double the cost of every write to buy nothing the snapshot does not have.
model AgentWriteJournal {
  id String @id @default(cuid(2))

  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The page that was written. Kept as a plain column with no foreign key:
  /// a page deleted for good must not take the record of its deletion with it.
  documentId    String
  /// Its title at the time of the write, so a deleted page still has a name.
  documentTitle String?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// The application event type that produced this row, e.g. `document.updated`.
  action String

  /// The snapshot holding the state *before* this write, when the write made
  /// one. Absent for mutations that snapshot nothing (a rename, a move), which
  /// is exactly why those cannot be reverted in bulk.
  snapshotBeforeId String?

  correlationId String
  createdAt     DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([documentId, createdAt])
  @@map("agent_write_journal")
}

// ---------------------------------------------------------------------------
// Entities (issue #47)
// ---------------------------------------------------------------------------

/// Where a mention came from.
///
/// The distinction decides what a re-extraction is allowed to touch: the pass
/// replaces every `EXTRACTED` row of a page and never a `MANUAL` one, so a
/// person who linked a page to an entity by hand does not have to do it again
/// after the next edit.
enum EntityMentionSource {
  EXTRACTED
  MANUAL
}

/// One page talks about one entity (issue #47).
///
/// The entity itself is *not* a model: it is a row in an ordinary ADR-011
/// database, so it has a title, a body, properties, references and a place in
/// the tree without a line of new rendering. This table is only the edge, and
/// an edge is exactly the thing a row cannot carry.
///
/// A typed table rather than a relation property, for the same reason
/// `MemoryFact` is one: the schema is fixed, it is written by the
/// materialization pass and never by a person, and the entity profile reads it
/// on the hot path of every recall.
model EntityMention {
  id String @id @default(cuid(2))

  /// The entity row this mention points at.
  entityDocumentId String
  entity           Document @relation("EntityMentionEntity", fields: [entityDocumentId], references: [id], onDelete: Cascade)

  /// The page doing the talking.
  documentId String
  document   Document @relation("EntityMentionPage", fields: [documentId], references: [id], onDelete: Cascade)

  /// Denormalized from the page. A profile is always filtered down to the
  /// workspaces the caller may read, and resolving that through the page on
  /// every read would join the document table for every row.
  workspaceId String

  /// The alias that matched, as written on the page. Which of an entity's
  /// names a page uses is itself information: "fpb2" and "der Hetzner-Server"
  /// are the same host addressed by two different kinds of reader.
  alias    String
  /// `alias` normalized the way the matcher normalizes. Not a lookup key here,
  /// it only makes "which spelling won" answerable without re-normalizing.
  aliasKey String

  /// How often the alias appears on the page. The difference between a page
  /// that is *about* the entity and one that name-drops it once.
  occurrences Int    @default(1)
  /// The sentence around the first occurrence, for the profile's preview.
  context     String

  source EntityMentionSource @default(EXTRACTED)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// One row per pair. A page mentioning an entity twelve times is one edge
  /// with `occurrences: 12`, not twelve edges.
  @@unique([entityDocumentId, documentId])
  /// "What does this page talk about?" -- and the delete before a re-extraction.
  @@index([documentId])
  /// The profile query: the pages about this entity, most recent first.
  @@index([entityDocumentId, lastSeenAt])
  @@map("entity_mention")
}

/// A name that keeps turning up and that no entity answers to yet (issue #47).
///
/// The reason the extraction does not simply create entities: a list nobody
/// pruned is worse than no list, and a matcher that invents rows from every
/// capitalized word fills it in a week. A candidate is therefore evidence, not
/// a decision -- it becomes an entity when a person or an agent confirms it, or
/// once it has been seen on enough separate pages to have earned the doubt.
///
/// No model is asked. Counting is deterministic, free and repeatable, and the
/// expensive half of the mechanism was the part the issue warned about.
model EntityCandidate {
  id String @id @default(cuid(2))

  /// The phrase as most recently written. Display only.
  phrase    String
  /// Normalized. The identity of the candidate.
  phraseKey String @unique

  /// Set when somebody decided this is not a thing. Kept rather than deleted:
  /// without it the next materialization pass proposes it again that evening.
  dismissedAt        DateTime?
  /// The entity row this candidate turned into, once confirmed.
  promotedDocumentId String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  sightings EntityCandidateSighting[]

  @@index([dismissedAt, lastSeenAt])
  @@map("entity_candidate")
}

/// One page on which a candidate phrase was seen.
///
/// The reason the threshold is honest: without a row per page, re-materializing
/// the same page four times would look like four separate pages saying the same
/// name, and every phrase on a page somebody keeps editing would cross any
/// threshold on its own.
model EntityCandidateSighting {
  id String @id @default(cuid(2))

  candidateId String
  candidate   EntityCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation("EntityCandidateSightingPage", fields: [documentId], references: [id], onDelete: Cascade)

  /// Denormalized from the page, for the same reason as on the mention: the
  /// candidate list is filtered to what the caller may read.
  workspaceId String

  occurrences Int      @default(1)
  context     String
  seenAt      DateTime @default(now())

  @@unique([candidateId, documentId])
  @@index([documentId])
  @@map("entity_candidate_sighting")
}

// ---------------------------------------------------------------------------
// Automations (issue #50, ADR-024)
// ---------------------------------------------------------------------------

/// What a rule listens for.
///
/// Deliberately a small enum rather than the raw `ApplicationEventType` string:
/// the event list is an internal transport vocabulary that grows whenever the
/// realtime channel needs a new message, and a rule stored against one of those
/// would start or stop firing because somebody renamed a socket event. These are
/// the changes a person can describe without knowing how the system is built.
enum AutomationTrigger {
  /// A page appeared in scope.
  DOCUMENT_CREATED
  /// Title, icon or another property of the page itself changed.
  DOCUMENT_UPDATED
  /// The page's *text* changed, i.e. materialization finished. Separate from
  /// `DOCUMENT_UPDATED` because these are the two questions people ask apart:
  /// "somebody renamed it" and "somebody wrote in it".
  DOCUMENT_CONTENT_CHANGED
  DOCUMENT_MOVED
  DOCUMENT_ARCHIVED
  DOCUMENT_DELETED
  /// A row's property value changed inside a database in scope.
  DATABASE_ROW_CHANGED
  /// The clock, not a change (issue #73). The odd member out on purpose: every
  /// other one names something that happened to a page. It lives here anyway
  /// because what a person writes is one rule either way, and the action half
  /// of a rule is identical whether a change or the time of day started it.
  SCHEDULE
}

/// The shapes a schedule can have (issue #73).
///
/// Four of them are what people ask for, and `CRON` is the escape hatch for the
/// fifth thing somebody will want. They are one enum rather than one cron string
/// because "every Sunday at 07:00" has to survive being read back into a form.
enum AutomationScheduleKind {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CRON
}

/// What started a run (issue #73).
///
/// Kept apart from the trigger, which says what the rule listens for: once the
/// clock can start a rule, a scheduled run that failed at 03:00 and a run
/// somebody started by hand to find out why carry the same trigger and are two
/// very different things to read in a log.
enum AutomationRunOrigin {
  EVENT
  SCHEDULE
  MANUAL
}

/// How far a rule reaches.
enum AutomationScope {
  /// Everything in the workspace.
  WORKSPACE
  /// One page and everything under it, at any depth.
  SUBTREE
  /// One COLLECTION and its rows (ADR-011), which is a subtree with a narrower
  /// trigger set but a very different thing to explain, so it is its own scope.
  DATABASE
}

/// What a rule does when it fires.
enum AutomationAction {
  /// A signed POST to a URL on the deployment's allowlist.
  WEBHOOK
  /// One prompt against the changed page, written back as a remark.
  AI_RUN
}

/// Where an `AI_RUN` rule puts its answer.
///
/// There is no "replace the page" member and there is not meant to be one: an
/// automation that rewrites content nobody asked it to rewrite is how a page
/// gets quietly destroyed by a rule somebody set up in March.
enum AutomationOutput {
  /// An unresolved comment on the page that triggered the rule.
  COMMENT
  /// A new page underneath the page that triggered the rule.
  CHILD_PAGE
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// Nothing was attempted, and why is in `error`: the rule was off, the
  /// feature was off, the page had gone, or the loop guard stopped it.
  SKIPPED
}

/// "When something changes here, do that" (issue #50, ADR-024).
///
/// The trigger side is the outbox (ADR-010) and nothing else: the dispatcher
/// already sees every domain event exactly once, in order, with at-least-once
/// delivery, so a rule needs no second event path and cannot miss a change
/// because Redis blinked.
///
/// The action side deliberately holds its two shapes in columns rather than in
/// one `config` blob. A webhook URL is the single most security-relevant value
/// in this table -- it is where data leaves the deployment -- and a column can
/// be indexed, audited and read at a glance, which a JSON key cannot.
model AutomationRule {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Shown to people. German, like every other name a person types.
  name    String
  /// The per-rule half of the emergency stop. The deployment-wide half is the
  /// `automations.enabled` setting, and the automatic half is
  /// `consecutiveFailures` below.
  enabled Boolean @default(true)

  scope           AutomationScope @default(WORKSPACE)
  /// The root of a `SUBTREE` scope or the COLLECTION of a `DATABASE` one. Null
  /// for `WORKSPACE`, and required for the other two.
  scopeDocumentId String?
  scopeDocument   Document?       @relation("AutomationScopeDocument", fields: [scopeDocumentId], references: [id], onDelete: Cascade)

  triggers AutomationTrigger[]

  /// How long a page has to stay quiet before the rule runs, in seconds.
  ///
  /// Not a refinement. A page being typed into produces a materialization every
  /// couple of seconds, and a rule with an AI action and no debounce would pay
  /// for a model call per paragraph. The floor is enforced in the contract, not
  /// here, so raising it later does not require a migration.
  debounceSeconds Int @default(60)

  /// The clock half of a rule (issue #73), null on an event rule.
  ///
  /// Columns rather than one cron string or one JSON blob: "every Sunday at
  /// 07:00 in Europe/Berlin" has to be read back into the form that wrote it,
  /// and `nextRunAt` has to be an indexed column because the sweep's only
  /// question, once a minute for ever, is which rules are due.
  scheduleKind       AutomationScheduleKind?
  /// `ONCE`: the moment, absolute.
  scheduleAt         DateTime?
  /// `DAILY`/`WEEKLY`/`MONTHLY`: `HH:MM` in `scheduleTimeZone`.
  scheduleTime       String?
  /// `WEEKLY`: 0 is Sunday, the way `Date` counts.
  scheduleWeekday    Int?
  /// `MONTHLY`: 1 to 31, clamped to the last day of a shorter month.
  scheduleDayOfMonth Int?
  /// `CRON`: five numeric fields, minute first.
  scheduleCron       String?
  /// The IANA zone the local times above are read in. Never guessed from the
  /// server's own zone: a rule that moved by an hour twice a year without
  /// anybody changing it would be a rule nobody trusts.
  scheduleTimeZone   String?
  /// When the schedule is due next, computed on write and again after each
  /// firing. Null on an event rule, and on a `ONCE` rule that has run.
  nextRunAt          DateTime?

  action AutomationAction

  /// `WEBHOOK`: where the POST goes. Checked against the allowlist on write
  /// *and* on use, because the allowlist can be narrowed after a rule exists.
  webhookUrl       String?
  /// `WEBHOOK`: the signing secret, AES-256-GCM under `CREDENTIAL_ENCRYPTION_KEY`
  /// exactly like a workspace's provider key (ADR-023). The plaintext is shown
  /// once, when the rule is created, and never again: the receiving end needs it
  /// to verify the signature, and this deployment needs never to be able to
  /// hand it back.
  secretCiphertext String?
  secretIv         String?
  secretAuthTag    String?
  secretKeyVersion Int?

  /// `AI_RUN`: what the model is asked, with the changed page as its material.
  prompt    String?
  /// `AI_RUN`: which model, or null for the workspace's default.
  modelSlug String?
  /// `AI_RUN`: where the answer is written.
  output    AutomationOutput @default(COMMENT)

  /// Failures since the last success. The rule switches itself off when this
  /// reaches `automations.maxConsecutiveFailures`, and the reason lands in
  /// `disabledReason` so the list can say why instead of just showing a rule
  /// that stopped working.
  consecutiveFailures Int       @default(0)
  disabledReason      String?
  disabledAt          DateTime?
  lastTriggeredAt     DateTime?

  /// Whose authority the action runs with: a webhook carries this workspace's
  /// data, an AI run writes as this person. Kept when the account goes, so a
  /// rule left behind by a departing colleague is visible rather than orphaned
  /// -- but a rule without an owner cannot act, and the processor skips it.
  createdById String?
  createdBy   User?    @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs AutomationRun[]

  /// The dispatcher's query: every enabled rule of one workspace, on every
  /// event. It is the hot path of this whole feature.
  @@index([workspaceId, enabled])
  @@index([scopeDocumentId])
  /// The schedule sweep's query, once a minute for ever: which rules are due.
  @@index([nextRunAt])
  @@map("automation_rule")
}

/// One firing of one rule, with what came of it (issue #50).
///
/// "Ohne das ist eine Automation ein Gerücht": a rule that runs invisibly is
/// indistinguishable from a rule that does not run, and the first question
/// anybody asks about an automation is what it did last night.
model AutomationRun {
  id     String         @id @default(cuid(2))
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// Denormalized from the rule so the log survives a workspace query without
  /// a join, and so a run keeps saying where it happened.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The page that triggered it. Null once that page is deleted for good, which
  /// is why the title is copied rather than joined.
  documentId    String?
  document      Document? @relation("AutomationRunDocument", fields: [documentId], references: [id], onDelete: SetNull)
  documentTitle String?

  trigger AutomationTrigger
  /// What started it. Defaulted for the rows that existed before the clock
  /// could start anything, which were all of them event-driven or manual and
  /// are honestly described as the former.
  origin  AutomationRunOrigin @default(EVENT)
  status  AutomationRunStatus @default(PENDING)

  /// How many automations deep this run is. Zero means a human or an agent
  /// caused the change; anything higher means an automation did, and
  /// `AUTOMATION_MAX_DEPTH` is where the chain stops.
  depth Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  /// English, developer-facing. The UI shows its own German sentence.
  error  String?
  /// Small, non-sensitive result metadata: the HTTP status of a webhook, the id
  /// of the comment or page an AI run wrote. Never the response body, never the
  /// prompt, never the answer -- the answer is a page or a comment and has a
  /// home already.
  detail Json?

  createdAt DateTime @default(now())

  @@index([ruleId, createdAt])
  @@index([workspaceId, createdAt])
  /// The retention sweep, which has no workspace to narrow by.
  @@index([createdAt])
  @@map("automation_run")
}

// ---------------------------------------------------------------------------
// Rendering: an existing page published as a file (issue #44, ADR-026)
// ---------------------------------------------------------------------------

/// How a job turns a document into a file. One value today; the enum exists so
/// the second renderer is a value, not a second set of tables.
enum Renderer {
  /// Pandoc into a LaTeX template into xelatex, all inside one container.
  LATEX_PDF
}

/// What goes into one render: the page alone, or the page and its descendants.
enum RenderSource {
  DOCUMENT
  SUBTREE
}

enum RenderJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// A way of turning pages into files, belonging to one workspace.
///
/// The template body is Pandoc's own template language, not a second one of
/// ours: `$title$`, `$body$`, `$for(...)$`. That is the whole reason this model
/// carries a string rather than a structure -- eXocortex does not own the
/// syntax, Pandoc does, and a template written here can be pasted into a Pandoc
/// invocation anywhere else and still work.
model RenderTemplate {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String @default("")

  renderer Renderer @default(LATEX_PDF)

  /// The Pandoc template. Null means the renderer's built-in one (Eisvogel for
  /// `LATEX_PDF`), which is what makes the first render possible without
  /// anybody writing LaTeX first.
  source String?

  /// The variables the template declares, shaped by `renderVariableSchema`.
  /// A Json column because it is a small list read as a whole, never filtered
  /// on, and its shape belongs to the contracts package.
  variables Json @default("[]")

  /// Kept when the account goes: a template outlives the colleague who wrote it.
  createdById String?
  createdBy   User?    @relation("RenderTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs RenderJob[]

  @@index([workspaceId, name])
  @@map("render_template")
}

/// One build, and what came of it.
///
/// The artifact is an ordinary `Attachment` rather than a table of its own.
/// That is deliberate: a PDF produced here has to be downloadable, deletable,
/// quota-counted and text-extractable exactly like a PDF somebody dragged in,
/// and a parallel artifact store would have to grow all four of those again --
/// and would then be the place where the text extraction that lets an agent
/// inspect a rendered page does *not* run.
model RenderJob {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The page that was rendered. Null once it is deleted for good, which is why
  /// the title is copied rather than joined.
  documentId    String?
  document      Document? @relation("RenderJobDocument", fields: [documentId], references: [id], onDelete: SetNull)
  documentTitle String?

  /// Null once the template is deleted. The job stays: what was built, and from
  /// what, is exactly the question somebody asks about an old PDF.
  templateId   String?
  template     RenderTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName String?

  renderer Renderer        @default(LATEX_PDF)
  source   RenderSource    @default(DOCUMENT)
  status   RenderJobStatus @default(PENDING)

  /// The resolved variable values this build used, `{ name: value }`.
  variables Json @default("{}")

  /// Fingerprint of everything that went in: the source text, the template, the
  /// renderer and the resolved variables. Two builds with the same hash produce
  /// the same file, which is what lets an unchanged page hand back the PDF it
  /// already has -- and what lets a page say its PDF is out of date without any
  /// invalidation logic.
  inputHash String

  /// English, developer-facing; the API turns it into a German sentence.
  errorCode String?
  /// stdout and stderr of the build, capped. The only place a broken template
  /// explains itself, so it is kept for failures and successes alike.
  log       String?

  /// The finished file. `SetNull` rather than cascade: deleting the attachment
  /// leaves a job that says it succeeded and has nothing to show, which is the
  /// truth, where a deleted job would silently lose the log as well.
  attachmentId String?
  attachment   Attachment? @relation("RenderJobArtifact", fields: [attachmentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?     @relation("RenderJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  /// Set the moment a cancel is asked for, before the worker notices. The
  /// worker checks it between its steps and kills the container.
  cancelledAt DateTime?
  /// Last sign of life from the worker. A RUNNING job without a recent one lost
  /// its worker, and `reap-stale-render-jobs` closes it as failed.
  heartbeatAt DateTime?

  @@index([workspaceId, createdAt])
  @@index([documentId, createdAt])
  /// The cache lookup: has this exact input already been built successfully?
  @@index([inputHash, status])
  /// The retention sweep and the stale-job reaper, neither of which has a
  /// workspace to narrow by.
  @@index([createdAt])
  @@index([status, heartbeatAt])
  @@map("render_job")
}

// ---------------------------------------------------------------------------
// Projects (issue #43, ADR-027)
// ---------------------------------------------------------------------------

/// What a project is made of. The value, not a model, is what keeps the domain
/// generic: `TYPST` and `QUARTO` are a runner and a set of defaults, and
/// nothing above the runner knows what a `.tex` file is.
enum ProjectType {
  LATEX
}

/// Which TeX binary `latexmk` drives.
enum ProjectEngine {
  PDFLATEX
  XELATEX
  LUALATEX
}

/// How the bibliography is produced. `AUTO` lets `latexmk` decide from what the
/// document actually loads, which is right nearly always and wrong loudly when
/// it is wrong -- hence the three explicit values beside it.
enum ProjectBibliography {
  AUTO
  BIBTEX
  BIBER
  NONE
}

/// A path in a project is one of two things, and the difference is where the
/// bytes live: a `TEXT` file's source is in the project's Yjs state and is
/// collaboratively editable, an `ASSET`'s bytes are an ordinary `Attachment` in
/// object storage and only its path is in the tree.
enum ProjectFileKind {
  TEXT
  ASSET
}

enum ProjectBuildStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// The project-specific half of a `Document` with `type: PROJECT`.
///
/// A sidecar rather than a model of its own: the tree position, the title, the
/// icon, the permissions, the trash, the snapshots and the comments are a
/// document's, and a project that reimplemented them would be a second tree
/// (ADR-011 took the same decision for databases). What is here is only what a
/// page does not have.
model Project {
  documentId String   @id
  document   Document @relation("ProjectDocument", fields: [documentId], references: [id], onDelete: Cascade)

  type ProjectType @default(LATEX)

  /// The file a build starts from. A path into the tree, validated on write:
  /// a root file that does not exist produces a build failure nobody can read.
  rootFile     String              @default("main.tex")
  engine       ProjectEngine       @default(PDFLATEX)
  bibliography ProjectBibliography @default(AUTO)

  /// When `ProjectFile` was last rebuilt from the Yjs state. `null` marks a
  /// project the materialization has never seen.
  materializedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files  ProjectFile[]
  builds ProjectBuild[]

  @@map("project")
}

/// One path in a project's file tree.
///
/// Derived, in the ADR-007 sense: the canonical tree is the project document's
/// Yjs state and these rows are the projection the materialization job rebuilds
/// from it, so that reading a project does not mean decoding a Yjs document and
/// so that a path can be queried. Writing here instead of through the
/// collaboration server writes a lie the next materialization erases.
model ProjectFile {
  id        String  @id @default(cuid(2))
  projectId String
  project   Project @relation(fields: [projectId], references: [documentId], onDelete: Cascade)

  /// Relative, `/`-separated, no leading slash, no `..`. Directories are not
  /// rows: a directory is the prefix of the paths under it, which is what makes
  /// an empty directory impossible and a rename a prefix substitution.
  path String
  kind ProjectFileKind

  /// `TEXT` only: the file's source as of the last materialization.
  content String?

  /// `ASSET` only: where the bytes are. `SetNull` rather than cascade, so
  /// deleting the attachment leaves a visible hole in the tree instead of
  /// silently changing what the next build compiles.
  attachmentId String?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  /// UTF-8 length for a text file, the attachment's size for an asset. Kept so
  /// a file tree can be drawn and a quota checked without reading the content.
  byteSize Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId, kind])
  @@map("project_file")
}

/// One build of one project, and what came of it.
///
/// Shaped after `RenderJob` on purpose (ADR-026): the artifact is an ordinary
/// attachment, the log is kept for failures and successes alike, a heartbeat is
/// what lets a lost worker be reaped, and the input hash is both the cache key
/// and the staleness comparison.
model ProjectBuild {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Null once the project is deleted for good. The build stays: what was built
  /// and what it said is exactly the question somebody asks about an old PDF,
  /// which is also why the title is copied rather than joined.
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [documentId], onDelete: SetNull)
  projectTitle String?

  /// The configuration this build actually used, copied from the project when
  /// the request was accepted. Changing the project afterwards must not change
  /// what an old build says it was.
  rootFile     String
  engine       ProjectEngine
  bibliography ProjectBibliography

  status ProjectBuildStatus @default(PENDING)

  /// Fingerprint of every input: each path with its content or its attachment
  /// checksum, plus the root file, the engine and the bibliography mode. Two
  /// builds with the same hash produce the same PDF, which is what lets an
  /// unchanged project hand back the file it already has and what lets a
  /// finished build report itself out of date without an invalidation flag.
  inputHash String

  /// English, developer-facing; the API turns it into a German sentence.
  errorCode   String?
  /// stdout and stderr of the whole run, capped. A TeX log is the only place a
  /// broken document explains itself in full.
  log         String?
  /// The parsed errors and warnings, shaped by `projectDiagnosticSchema`: what
  /// an agent acts on, where the log is what it falls back to. A Json column
  /// because it is a list read as a whole and never filtered on.
  diagnostics Json    @default("[]")

  /// The finished PDF.
  attachmentId          String?
  attachment            Attachment? @relation("ProjectBuildArtifact", fields: [attachmentId], references: [id], onDelete: SetNull)
  /// The SyncTeX map, gzipped, as produced by the engine. What resolves a
  /// position in the PDF back to a file and a line -- for the person clicking
  /// in the viewer and for the agent asking where page 17 comes from.
  sourceMapAttachmentId String?
  sourceMapAttachment   Attachment? @relation("ProjectBuildSourceMap", fields: [sourceMapAttachmentId], references: [id], onDelete: SetNull)

  /// Pages the finished PDF has. Read from the artifact, so an agent can ask
  /// for a page range without downloading the file first.
  pageCount Int?

  createdById String?
  createdBy   User?     @relation("ProjectBuildCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  /// Set the moment a cancel is asked for, before the worker notices.
  cancelledAt DateTime?
  /// Last sign of life from the worker. A RUNNING job without a recent one lost
  /// its worker, and `reap-stale-project-builds` closes it as failed.
  heartbeatAt DateTime?

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  /// The cache lookup: has this exact input already been built successfully?
  @@index([inputHash, status])
  /// The retention sweep and the stale-build reaper, neither of which has a
  /// workspace to narrow by.
  @@index([createdAt])
  @@index([status, heartbeatAt])
  @@map("project_build")
}
