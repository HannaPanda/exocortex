{
  "name": "@exocortex/mail",
  "version": "0.1.0",
  "private": true,
  "description": "SMTP transport and the typed mail templates, shared by the API and the worker",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests integration.test"
  },
  "dependencies": {
    "@exocortex/contracts": "workspace:*",
    "@exocortex/logger": "workspace:*",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/nodemailer": "8.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
