{
  "name": "@exocortex/queue",
  "version": "0.1.0",
  "private": true,
  "description": "Typed BullMQ queues, workers and job scheduling primitives",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
