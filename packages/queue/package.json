{
  "name": "@exocortex/queue",
  "version": "0.1.0",
  "private": true,
  "description": "Typed BullMQ queues, workers and job scheduling primitives",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests integration.test"
  },
  "dependencies": {
    "@exocortex/config": "workspace:*",
    "@exocortex/contracts": "workspace:*",
    "@exocortex/logger": "workspace:*",
    "bullmq": "6.3.6",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
