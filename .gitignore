node_modules/
dist/
build/
.next/
# The web releases scripts/deploy.sh stages, and the symlink the web unit
# serves (issue #130). No trailing slash on the link: git sees a symlink as a file.
.next-releases/
.next-live
out/
coverage/
.turbo/
*.tsbuildinfo

.env
.env.local
.env.*.local
# Backups the Infisical sync writes before it merges. Same secrets as the .env,
# and the pattern above does not match them.
.env.bak-*
!.env.example

# Playwright
playwright-report/
test-results/
blob-report/
.playwright/

# Local runtime artefacts
logs/
*.log
.DS_Store

# Generated Prisma client output
packages/database/generated/

# Local secrets that must never be committed
secrets/

# Prisma CLI convenience symlink to the root .env (target is ignored above)
packages/database/.env

# Next.js reads env files from its own directory; this symlink points at the
# repository root .env (which is ignored above).
apps/web/.env

# Playwright global-setup writes real session cookies here for reuse across
# the suite. The old unanchored pattern (`support/.auth/`) never matched this
# nested path, so these were tracked with live tokens until 2026-08-05.
e2e/support/.auth/

# Playwright test artefacts
e2e/.created-workspaces
e2e/.run-scope

# Machine-identity credentials for the Infisical -> .env sync
# (deploy/infisical-sync-env.py). Template: deploy/infisical-sync.env.example
.infisical-sync.env

# Marker written by scripts/build.sh: the commit the artefacts in dist/ and
# .next/ belong to. Local state, never shared.
.build-marker
# Marker written by scripts/deploy.sh on a fully successful rollout.
.last-deployed-sha

# Index and notes written by the Serena MCP server when a session activates this
# project. Local tooling state, regenerated on demand, never shared.
.serena/

# Per-machine Claude Code state: permission decisions, scheduler locks. Local
# tooling state like `.serena/`, never shared. The exception is `skills/`: a
# project skill is part of the repository, because a review rule that lives on
# one machine is a rule the other machine does not follow.
.claude/*
!.claude/skills/

# Byte code and virtual environments of the Python integration under
# `integrations/`. Build output like `dist/`, never shared.
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Impeccable design-detector state. `config.json` carries decisions -- which
# findings this project has ruled out and why -- so it is shared. The hook
# cache and the critique snapshots are per-run artifacts of one machine. The
# hook writes its cache next to the workspace it scanned, so the rule has to
# reach apps/web as well -- Prettier reads this file, not .git/info/exclude.
.impeccable/*
!.impeccable/config.json
apps/web/.impeccable/
packages/mail/mail-preview/
