[Unit]
Description=Restore the newest MEGA snapshots into scratch databases
Documentation=file:///var/www/exocortex/deploy/README.md
After=network-online.target docker.service
Wants=network-online.target
OnFailure=exocortex-backup-alert@%n.service

[Service]
Type=oneshot
User=johanna
Group=johanna
Environment=HOME=/home/johanna
WorkingDirectory=/var/www/exocortex
ExecStart=/var/www/exocortex/deploy/backup-restore-test.sh
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exocortex-backup-verify

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# The scratch download lands here, not in /tmp: megacmd's server process lives
# outside this unit's PrivateTmp namespace and cannot write into it.
ReadWritePaths=/var/backups/exocortex
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
