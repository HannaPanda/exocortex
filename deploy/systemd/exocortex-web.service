[Unit]
Description=Exocortex web frontend (Next.js)
Documentation=file:///var/www/exocortex/docs/local-development.md
After=network-online.target exocortex-api.service
Wants=network-online.target

[Service]
Type=simple
User=johanna
Group=johanna
WorkingDirectory=/var/www/exocortex/apps/web
# Configuration is read from /var/www/exocortex/.env by @exocortex/config.
Environment=NODE_ENV=production
# Serve the release scripts/deploy.sh switched to, never the .next directory a
# build writes into while this process is running (issue #130).
Environment=EXOCORTEX_WEB_DIST_DIR=.next-live
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3210 --hostname 127.0.0.1
Restart=always
RestartSec=3
# Graceful shutdown: every process closes queues, sockets and the database pool
# on SIGTERM (see docs/background-jobs.md).
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exocortex-web

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# `true`, not `read-only`: these services run as `johanna`, so a read-only
# /home still hands anything that achieves code execution here the SSH private
# keys in ~/.ssh and the MCP tokens in ~/.claude.json. Nothing under /home is
# needed -- the code lives in /var/www/exocortex and its configuration comes
# from the .env there.
ProtectHome=true
ReadWritePaths=/var/www/exocortex
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
