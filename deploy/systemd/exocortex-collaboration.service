[Unit]
Description=Exocortex collaboration server (Hocuspocus)
Documentation=file:///var/www/exocortex/docs/local-development.md
After=network-online.target docker.service exocortex-api.service
Wants=network-online.target

[Service]
Type=simple
User=johanna
Group=johanna
WorkingDirectory=/var/www/exocortex/apps/collaboration
# Configuration is read from /var/www/exocortex/.env by @exocortex/config.
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3
# Graceful shutdown: every process closes queues, sockets and the database pool
# on SIGTERM (see docs/background-jobs.md).
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exocortex-collaboration

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# `true`, not `read-only`: these services run as `johanna`, so a read-only
# /home still hands anything that achieves code execution here the SSH private
# keys in ~/.ssh and the MCP tokens in ~/.claude.json. Nothing under /home is
# needed -- the code lives in /var/www/exocortex and its configuration comes
# from the .env there.
ProtectHome=true
ReadWritePaths=/var/www/exocortex
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The account is in the `docker` group, and reaching that socket is root on
# the host (issue #183). No unit of the application needs it: LaTeX builds go
# through `exocortex-sandbox`, which the worker reaches on its own socket.
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd

[Install]
WantedBy=multi-user.target
