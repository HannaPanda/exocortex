# Template for /var/www/exocortex/.infisical-sync.env (git-ignored, chmod 600).
#
# Read by deploy/infisical-sync-env.py. Holds the machine-identity credentials
# that let this host pull its managed secrets out of Infisical.

INFISICAL_BASE=https://infisical.hannapanda.de

# Machine identity "Hermes Agent" (Universal Auth). The same identity serves the
# Windmill, Hermes Agent and Exocortex projects; rotating it affects all three.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Project "Exocortex", environment "prod", secret path "/".
INFISICAL_PROJECT_ID=83526c90-de12-446f-afcd-26adc138c01c
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/

# The one .env in the repository root; apps/web and packages/database symlink to it.
TARGET_ENV_FILE=/var/www/exocortex/.env

# Comma-separated keys that live in Infisical but must not reach this .env.
# Empty means "sync everything the project holds".
EXCLUDE_KEYS=
