{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.node.json", "tsconfig.react.json", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "REDIS_URL",
    "APP_URL",
    "API_URL",
    "PUBLIC_API_URL",
    "PUBLIC_COLLABORATION_URL",
    "COLLABORATION_URL",
    "COLLABORATION_TICKET_SECRET",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_FROM",
    "LOG_LEVEL",
    "WEB_PORT",
    "API_PORT",
    "COLLABORATION_PORT",
    "AI_PROVIDER",
    "OPENROUTER_API_KEY",
    "OPENROUTER_DEFAULT_MODEL",
    "OPENROUTER_VISION_MODEL",
    "SERVICE_TOKEN_SECRET",
    "SERVICE_TOKEN_TTL_SECONDS",
    "SEED_JOHANNA_PASSWORD",
    "SEED_STEFAN_PASSWORD",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["EXOCORTEX_TEST_INFRA", "EXOCORTEX_TEST_DATABASE_URL", "EXOCORTEX_TEST_REDIS_URL"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
