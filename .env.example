# ---------------------------------------------------------------------------
# Exocortex environment template.
#
#   cp .env.example .env
#
# Every value below is a local development default. Never commit a real .env.
# All variables are validated at startup by @exocortex/config; a missing or
# malformed value aborts the process with an explicit English error message.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Ports (host side) -----------------------------------------------------
WEB_PORT=3210
API_PORT=3211
COLLABORATION_PORT=3212

# --- Public URLs -----------------------------------------------------------
# APP_URL is the browser-visible origin of the web application.
APP_URL=http://localhost:3210
# API_URL is used for server-to-server calls inside the deployment.
API_URL=http://127.0.0.1:3211
# The API pushes writes that did not come from the editor into open editing
# sessions through this URL. It serves a private endpoint and must stay on
# loopback: never publish it through the reverse proxy.
COLLABORATION_INTERNAL_URL=http://127.0.0.1:3212
# PUBLIC_* values are exposed to the browser bundle. They must not contain secrets.
PUBLIC_API_URL=http://localhost:3211
PUBLIC_COLLABORATION_URL=ws://localhost:3212

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=exocortex
POSTGRES_PASSWORD=exocortex
POSTGRES_DB=exocortex
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://exocortex:exocortex@127.0.0.1:5433/exocortex?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_HOST_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# --- Object storage (MinIO locally, any S3-compatible service in production)
MINIO_HOST_PORT=9110
MINIO_CONSOLE_HOST_PORT=9111
S3_ENDPOINT=http://127.0.0.1:9110
S3_REGION=us-east-1
S3_BUCKET=exocortex
S3_ACCESS_KEY_ID=exocortex
S3_SECRET_ACCESS_KEY=exocortex-dev-secret
S3_FORCE_PATH_STYLE=true

# --- Mail (Mailpit locally) ------------------------------------------------
MAILPIT_SMTP_HOST_PORT=1026
MAILPIT_UI_HOST_PORT=8026
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=eXocortex <no-reply@exocortex.app>
# Credentials for the relay. Leave both empty for Mailpit, which accepts
# anything and speaks no TLS. Setting them switches the transport to STARTTLS
# and makes it refuse to send at all if the relay cannot upgrade -- a password
# must never cross the wire in the clear.
SMTP_USER=
SMTP_PASSWORD=

# --- Secrets ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3210
# Signs short-lived collaboration tickets. Must differ from BETTER_AUTH_SECRET.
COLLABORATION_TICKET_SECRET=replace-me-with-openssl-rand-hex-32
COLLABORATION_TICKET_TTL_SECONDS=60
# Signs short-lived `exos_` service tokens, which the API accepts as bearer
# credentials resolving to the acting user. Two processes mint them: the worker,
# once per AI run, and the API, once per MCP request from an OAuth client that
# holds no `exo_` token. Optional, but leaving it out costs both of those: the
# built-in AI runs without tools and /api/mcp refuses every OAuth client.
SERVICE_TOKEN_SECRET=
SERVICE_TOKEN_TTL_SECONDS=300

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- AI --------------------------------------------------------------------
# `mock` is the only provider enabled by default. No real requests are made.
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Main driver. GLM 5.2 is text-only: no vision, so document images are
# described by OPENROUTER_VISION_MODEL first (docs/adr/ADR-012-vision-preprocessing.md).
OPENROUTER_DEFAULT_MODEL=z-ai/glm-5.2
# Cheap vision model, used only to turn document images into text for the
# model above. Leave empty to skip image preprocessing entirely.
OPENROUTER_VISION_MODEL=qwen/qwen3.7-flash

# --- PDF extraction --------------------------------------------------------
# Local docling-serve instance (`docker compose up -d docling`). Leave empty to
# keep PDF extraction on the OpenRouter `pdf-text` engine, which is cheaper and
# needs no container but cannot read scanned PDFs at all. Which of the two is
# used is decided at runtime by the `ai.pdfExtractor` setting.
DOCLING_BASE_URL=
DOCLING_HOST_PORT=5010

# --- Calendar (CalDAV) -----------------------------------------------------
# Read by the worker's calendar sync. All three unset means "no calendar
# configured" and the sync job does nothing.
#
# On the deployment these are NOT edited here: Infisical (project `Exocortex`,
# env `prod`) is the source of truth and `deploy/infisical-sync-env.py` merges
# them into the root .env nightly. Set them by hand only for local development.
#
# Use an app-specific password, never the account password: it can be revoked
# on its own and it gives no access to the mailbox.
MAILBOX_CALDAV_URL=https://dav.mailbox.org/
MAILBOX_CALDAV_USERNAME=
MAILBOX_CALDAV_PASSWORD=

# How an appointment reminder leaves the deployment: an executable that takes the
# message on stdin as `<command> send --to <target> --quiet --file -`, plus the
# target to hand it. On this host that is Hermes' one-shot sender, which reaches
# Telegram with the gateway's own credentials and without starting an LLM.
#
# Not a secret and therefore not in Infisical: it is an absolute path on this
# machine. Both halves have to be set, otherwise reminders stay off however
# `calendar.remindersEnabled` is switched in the admin area.
CALENDAR_REMINDER_COMMAND=
CALENDAR_REMINDER_TARGET=

# --- Seeding ---------------------------------------------------------------
# Leave empty to have `pnpm db:seed` generate one-time passwords and print them.
SEED_JOHANNA_PASSWORD=
SEED_STEFAN_PASSWORD=

# --- Browser tests ---------------------------------------------------------
# Read by `pnpm test:e2e` only. The suite runs against a deployment that is
# already up, so the base URL is the one you want tested; empty falls back to
# APP_URL. The two basic-auth values are for a deployment that still has a realm
# in front of it -- exocortex.app has none.
E2E_BASE_URL=
E2E_BASIC_USER=
E2E_BASIC_PASSWORD=
# Set to 1 to keep the pages a run created, for looking at a failure. Off by
# default: the suite cleans up after itself.
E2E_SKIP_CLEANUP=

# --- Local tooling ---------------------------------------------------------
# Read by the maintenance scripts in `scripts/`, which talk to a running
# deployment over REST rather than to the database.
EXOCORTEX_API_URL=http://127.0.0.1:3211
EXOCORTEX_API_TOKEN=
# Set to 1 to switch off the Claude Code memory hooks in `tools/claude-code-hooks`
# (ADR-019) without unregistering them.
EXOCORTEX_MEMORY_DISABLED=
