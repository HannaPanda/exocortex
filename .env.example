# ---------------------------------------------------------------------------
# Exocortex environment template.
#
#   cp .env.example .env
#
# Every value below is a local development default. Never commit a real .env.
# All variables are validated at startup by @exocortex/config; a missing or
# malformed value aborts the process with an explicit English error message.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Ports (host side) -----------------------------------------------------
WEB_PORT=3210
API_PORT=3211
COLLABORATION_PORT=3212

# --- Public URLs -----------------------------------------------------------
# APP_URL is the browser-visible origin of the web application.
APP_URL=http://localhost:3210
# API_URL is used for server-to-server calls inside the deployment.
API_URL=http://127.0.0.1:3211
# The API pushes writes that did not come from the editor into open editing
# sessions through this URL. It serves a private endpoint and must stay on
# loopback: never publish it through the reverse proxy.
COLLABORATION_INTERNAL_URL=http://127.0.0.1:3212
# PUBLIC_* values are exposed to the browser bundle. They must not contain secrets.
PUBLIC_API_URL=http://localhost:3211
PUBLIC_COLLABORATION_URL=ws://localhost:3212

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=exocortex
POSTGRES_PASSWORD=exocortex
POSTGRES_DB=exocortex
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://exocortex:exocortex@127.0.0.1:5433/exocortex?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_HOST_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# --- Object storage (MinIO locally, any S3-compatible service in production)
MINIO_HOST_PORT=9110
MINIO_CONSOLE_HOST_PORT=9111
S3_ENDPOINT=http://127.0.0.1:9110
S3_REGION=us-east-1
S3_BUCKET=exocortex
S3_ACCESS_KEY_ID=exocortex
S3_SECRET_ACCESS_KEY=exocortex-dev-secret
S3_FORCE_PATH_STYLE=true

# --- Mail (Mailpit locally) ------------------------------------------------
MAILPIT_SMTP_HOST_PORT=1026
MAILPIT_UI_HOST_PORT=8026
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=Exocortex <no-reply@exocortex.app>

# --- Secrets ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3210
# Signs short-lived collaboration tickets. Must differ from BETTER_AUTH_SECRET.
COLLABORATION_TICKET_SECRET=replace-me-with-openssl-rand-hex-32
COLLABORATION_TICKET_TTL_SECONDS=60

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- AI --------------------------------------------------------------------
# `mock` is the only provider enabled by default. No real requests are made.
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Main driver. GLM 5.2 is text-only: no vision, so document images are
# described by OPENROUTER_VISION_MODEL first (docs/adr/ADR-012-vision-preprocessing.md).
OPENROUTER_DEFAULT_MODEL=z-ai/glm-5.2
# Cheap vision model, used only to turn document images into text for the
# model above. Leave empty to skip image preprocessing entirely.
OPENROUTER_VISION_MODEL=qwen/qwen3.7-flash

# --- PDF extraction --------------------------------------------------------
# Local docling-serve instance (`docker compose up -d docling`). Leave empty to
# keep PDF extraction on the OpenRouter `pdf-text` engine, which is cheaper and
# needs no container but cannot read scanned PDFs at all. Which of the two is
# used is decided at runtime by the `ai.pdfExtractor` setting.
DOCLING_BASE_URL=
DOCLING_HOST_PORT=5010

# --- Seeding ---------------------------------------------------------------
# Leave empty to have `pnpm db:seed` generate one-time passwords and print them.
SEED_JOHANNA_PASSWORD=
SEED_STEFAN_PASSWORD=
